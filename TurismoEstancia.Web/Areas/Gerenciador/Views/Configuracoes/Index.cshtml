@model IReadOnlyList<ConfiguracaoSiteDto>
@{
    ViewData["Title"] = "Configurações";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Configurações</h1>
        <p class="painel-page-desc">Slots únicos do site: guia em PDF, vídeo institucional, título e SEO.</p>
    </div>
    <a class="btn-painel btn-painel--primary" asp-action="Criar"><i data-lucide="plus"></i> Nova configuração</a>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Chave</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Valor</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code>@item.Chave</code></td>
                        <td><strong>@item.Nome</strong></td>
                        <td>
                            <span class="painel-badge @(item.Tipo == TipoConfiguracao.Arquivo ? "painel-badge--orange" : "painel-badge--cyan")">
                                @(item.Tipo == TipoConfiguracao.Arquivo ? "Arquivo" : "Texto")
                            </span>
                        </td>
                        <td style="max-width:320px;">
                            @if (item.Tipo == TipoConfiguracao.Arquivo && item.ArquivoId is long id)
                            {
                                <a href="/arquivo/@id" target="_blank">@(item.ArquivoNome ?? "Arquivo")</a>
                            }
                            else
                            {
                                @(item.ValorTexto ?? "—")
                            }
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Excluir a configuração '@item.Nome'?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs"><i data-lucide="trash-2"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhuma configuração cadastrada. Chaves esperadas: logo-principal (Arquivo), guia-pdf, video-institucional, site-titulo.</div>
    }
</div>
