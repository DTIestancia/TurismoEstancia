@model ConhecaEstanciaItemDto
@{
    ViewData["Title"] = "Novo item do Conheça Estância";
    ViewData["AreaAtiva"] = "conheca";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Novo item do Conheça Estância</h1>
        <p class="painel-page-desc">A foto ocupa a seção inteira; nome e descrição ficam sobrepostos com sombreamento.</p>
    </div>
</div>

<form class="painel-form" asp-action="Criar" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-form-grid">
        <div class="painel-field">
            <label asp-for="Categoria"></label>
            <select asp-for="Categoria" class="painel-input">
                <option value="Historia">História</option>
                <option value="Cultura">Cultura</option>
                <option value="Gastronomia">Gastronomia</option>
                <option value="Experiencias">Experiências</option>
            </select>
            <span asp-validation-for="Categoria" class="field-validation-error"></span>
        </div>
        <div class="painel-field">
            <label asp-for="Ordem"></label>
            <input asp-for="Ordem" class="painel-input" type="number" />
        </div>
    </div>

    <div class="painel-field">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="painel-input" maxlength="200" />
        <span asp-validation-for="Nome" class="field-validation-error"></span>
    </div>

    <div class="painel-field">
        <label asp-for="Descricao"></label>
        <textarea asp-for="Descricao" class="painel-input" rows="4" maxlength="1000" placeholder="Texto sobreposto à foto na seção do portal."></textarea>
        <span asp-validation-for="Descricao" class="field-validation-error"></span>
    </div>

    <div class="painel-field">
        <label asp-for="Corpo"></label>
        <textarea asp-for="Corpo" class="painel-textarea"></textarea>
        @await Html.PartialAsync("_EditorTextoRico", "Corpo")
        <span class="painel-hint">Editor rico — negrito, itálico, tamanho de fonte, cor, listas e links. Exibido na página /conheca-estancia/{id}.</span>
    </div>

    <div class="painel-field">
        <label>Foto da seção</label>
        <input type="file" name="imagem" accept="image/*" class="painel-input" />
        @await Html.PartialAsync("_AjusteImagemConheca", Model)
        <span class="painel-hint">Imagem exibida no deck da home e na página de detalhe. Ajuste o recorte acima — salvo mesmo sem trocar a imagem.</span>
    </div>

    <div class="painel-field">
        <label class="painel-checkbox">
            <input asp-for="Ativo" /> Ativo no portal
        </label>
    </div>

    <div class="painel-form-actions">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar</button>
        <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
    </div>
</form>
