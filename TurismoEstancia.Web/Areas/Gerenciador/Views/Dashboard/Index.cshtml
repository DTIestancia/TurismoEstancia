@model DashboardAnalyticsViewModel
@{
    ViewData["Title"] = "Dashboard";
    var serie = Model.Resumo.VisitasPorDia;
    var labelsLinha = serie.Select(s => s.Data.ToString("dd/MM")).ToList();
    var dadosLinha = serie.Select(s => s.Quantidade).ToList();
    var labelsPaginas = Model.Resumo.TopPaginas.Select(p => string.IsNullOrWhiteSpace(p.Rotulo) ? "/" : p.Rotulo).ToList();
    var dadosPaginas = Model.Resumo.TopPaginas.Select(p => p.Quantidade).ToList();
    var labelsDispositivos = Model.Resumo.Dispositivos.Select(d => d.Rotulo).ToList();
    var dadosDispositivos = Model.Resumo.Dispositivos.Select(d => d.Quantidade).ToList();
    var labelsFontes = Model.Resumo.Fontes.Select(f => f.Rotulo).ToList();
    var dadosFontes = Model.Resumo.Fontes.Select(f => f.Quantidade).ToList();
    var labelsMaravilhas = Model.Resumo.TopMaravilhas.Select(m => m.Rotulo).ToList();
    var dadosMaravilhas = Model.Resumo.TopMaravilhas.Select(m => m.Quantidade).ToList();
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Dashboard de análises</h1>
        <p class="painel-page-desc">
            Audiência do portal nos últimos @Model.PeriodoDias dias — dados anônimos (LGPD-safe, sem IP),
            coletados de visitas e cliques nas páginas públicas.
        </p>
    </div>
    <div class="painel-periodo" role="group" aria-label="Período">
        <a class="@(Model.PeriodoDias == 7 ? "active" : "")" asp-action="Index" asp-route-dias="7">7 dias</a>
        <a class="@(Model.PeriodoDias == 30 ? "active" : "")" asp-action="Index" asp-route-dias="30">30 dias</a>
        <a class="@(Model.PeriodoDias == 90 ? "active" : "")" asp-action="Index" asp-route-dias="90">90 dias</a>
    </div>
</div>

<!-- ===== KPIs de audiência ===== -->
<div class="painel-kpis">
    <div class="painel-stat painel-kpi">
        <div class="painel-stat-value">@Model.Resumo.Visitas</div>
        <div class="painel-stat-label">Visitas no período</div>
        <div class="painel-stat-icon"><i data-lucide="eye" width="22" height="22"></i></div>
    </div>
    <div class="painel-stat painel-kpi">
        <div class="painel-stat-value">@Model.Resumo.VisitasHoje</div>
        <div class="painel-stat-label">Visitas hoje</div>
        <div class="painel-stat-icon"><i data-lucide="zap" width="22" height="22"></i></div>
    </div>
    <div class="painel-stat painel-kpi">
        <div class="painel-stat-value">@Model.Resumo.VisitantesUnicos</div>
        <div class="painel-stat-label">Visitantes únicos</div>
        <div class="painel-stat-icon"><i data-lucide="users" width="22" height="22"></i></div>
    </div>
    <div class="painel-stat painel-kpi">
        <div class="painel-stat-value">@Model.Resumo.Cliques</div>
        <div class="painel-stat-label">Cliques rastreados</div>
        <div class="painel-stat-icon"><i data-lucide="mouse-pointer-click" width="22" height="22"></i></div>
    </div>
</div>

<!-- ===== Gráficos ===== -->
<div class="painel-charts-grid">
    <div class="painel-card painel-chart painel-chart--wide">
        <div class="painel-card-title"><i data-lucide="trending-up"></i> Visitas por dia</div>
        <div class="painel-chart-canvas"><canvas id="chartVisitas" height="120"></canvas></div>
    </div>
    <div class="painel-card painel-chart">
        <div class="painel-card-title"><i data-lucide="smartphone"></i> Dispositivos</div>
        <div class="painel-chart-canvas"><canvas id="chartDispositivos" height="150"></canvas></div>
    </div>

    <div class="painel-card painel-chart painel-chart--wide">
        <div class="painel-card-title"><i data-lucide="bar-chart-3"></i> Top páginas mais visitadas</div>
        <div class="painel-chart-canvas"><canvas id="chartPaginas" height="150"></canvas></div>
    </div>
    <div class="painel-card painel-chart">
        <div class="painel-card-title"><i data-lucide="share-2"></i> Fontes de tráfego</div>
        <div class="painel-chart-canvas"><canvas id="chartFontes" height="150"></canvas></div>
    </div>

    <div class="painel-card painel-chart painel-chart--wide">
        <div class="painel-card-title"><i data-lucide="sparkles"></i> Maravilhas mais clicadas ("Ver detalhes")</div>
        <div class="painel-chart-canvas"><canvas id="chartMaravilhas" height="150"></canvas></div>
    </div>
    <div class="painel-card painel-chart">
        <div class="painel-card-title"><i data-lucide="mouse-pointer-click"></i> Cliques por evento</div>
        <div class="painel-chart-canvas"><canvas id="chartEventos" height="150"></canvas></div>
    </div>
</div>

<!-- ===== Rankings + Newsletter + SEO ===== -->
<div class="painel-charts-grid">
    <div class="painel-card">
        <div class="painel-card-title"><i data-lucide="trophy"></i> Top páginas</div>
        <div class="painel-table-wrap">
            <table class="painel-table">
                <thead><tr><th>#</th><th>Página</th><th>Visitas</th></tr></thead>
                <tbody>
                    @if (Model.Resumo.TopPaginas.Count == 0)
                    {
                        <tr><td colspan="3" class="painel-empty">Sem dados no período.</td></tr>
                    }
                    @for (var i = 0; i < Model.Resumo.TopPaginas.Count; i++)
                    {
                        var p = Model.Resumo.TopPaginas[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(p.Rotulo) ? "/" : p.Rotulo)</strong></td>
                            <td>@p.Quantidade</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="painel-card">
        <div class="painel-card-title"><i data-lucide="globe"></i> Origens (referrers)</div>
        <div class="painel-table-wrap">
            <table class="painel-table">
                <thead><tr><th>#</th><th>Domínio</th><th>Visitas</th></tr></thead>
                <tbody>
                    @if (Model.Resumo.TopReferrers.Count == 0)
                    {
                        <tr><td colspan="3" class="painel-empty">Ainda não há tráfego externo.</td></tr>
                    }
                    @for (var i = 0; i < Model.Resumo.TopReferrers.Count; i++)
                    {
                        var r = Model.Resumo.TopReferrers[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td><strong>@r.Rotulo</strong></td>
                            <td>@r.Quantidade</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="painel-charts-grid">
    <div class="painel-card">
        <div class="painel-card-title"><i data-lucide="mail"></i> Newsletter</div>
        <div class="painel-newsletter-stats">
            <div class="painel-newsletter-stat">
                <div class="painel-newsletter-value">+@Model.NewsletterNoPeriodo</div>
                <div class="painel-newsletter-label">novas inscrições no período</div>
            </div>
            <div class="painel-newsletter-stat">
                <div class="painel-newsletter-value">@Model.NewsletterAtivas</div>
                <div class="painel-newsletter-label">inscrições ativas hoje</div>
            </div>
        </div>
        <div class="painel-actions" style="margin-top:14px;">
            <a class="btn-painel btn-painel--ghost btn-painel--sm" asp-controller="Newsletter" asp-action="Index">
                <i data-lucide="users"></i> Gerenciar inscrições
            </a>
        </div>
    </div>

    <div class="painel-card">
        <div class="painel-card-title"><i data-lucide="search"></i> SEO do portal</div>
        <div class="painel-seo-item">
            <span class="painel-seo-label">Título</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.SeoTitulo) ? "—" : Model.SeoTitulo)</strong>
        </div>
        <div class="painel-seo-item">
            <span class="painel-seo-label">Meta descrição</span>
            <span>@(string.IsNullOrWhiteSpace(Model.SeoDescricao) ? "—" : Model.SeoDescricao)</span>
        </div>
        <div class="painel-seo-item">
            <span class="painel-seo-label">Rotas indexáveis</span>
            <span>@Model.RotasIndexaveis rotas públicas no sitemap</span>
        </div>
        <div class="painel-actions" style="margin-top:14px;">
            <a class="btn-painel btn-painel--ghost btn-painel--sm" href="/sitemap.xml" target="_blank">
                <i data-lucide="file-code"></i> sitemap.xml
            </a>
            <a class="btn-painel btn-painel--ghost btn-painel--sm" href="/robots.txt" target="_blank">
                <i data-lucide="file-text"></i> robots.txt
            </a>
            <a class="btn-painel btn-painel--ghost btn-painel--sm" asp-controller="Configuracoes" asp-action="Index">
                <i data-lucide="settings"></i> Configurar SEO
            </a>
        </div>
    </div>
</div>

<!-- ===== Contadores de conteúdo ===== -->
<div class="painel-card-title" style="margin-top:6px;"><i data-lucide="database"></i> Conteúdo publicado</div>
<div class="painel-stats-grid">
    @foreach (var item in Model.Conteudos)
    {
        <div class="painel-stat">
            <div class="painel-stat-value">@item.Valor</div>
            <div class="painel-stat-label">@item.Rotulo</div>
            <div class="painel-stat-icon"><i data-lucide="@item.Icone" width="22" height="22"></i></div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            Chart.defaults.color = 'rgba(255,255,255,0.65)';
            Chart.defaults.borderColor = 'rgba(255,255,255,0.08)';
            Chart.defaults.font.family = 'Inter, sans-serif';

            var laranja = '#F97E31', vermelho = '#ED2027', verde = '#658746',
                ciano = '#0095F6', amarelo = '#FCBB0F', rosa = '#E9568A';

            // Linha: visitas por dia
            var elVisitas = document.getElementById('chartVisitas');
            if (elVisitas) {
                new Chart(elVisitas, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(Js(labelsLinha)),
                        datasets: [{
                            label: 'Visitas',
                            data: @System.Text.Json.JsonSerializer.Serialize(dadosLinha),
                            borderColor: laranja,
                            backgroundColor: 'rgba(247,100,0,0.12)',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 2,
                            pointHoverRadius: 5,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            // Rosca: dispositivos
            var elDisp = document.getElementById('chartDispositivos');
            if (elDisp) {
                new Chart(elDisp, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(Js(labelsDispositivos)),
                        datasets: [{
                            data: @System.Text.Json.JsonSerializer.Serialize(dadosDispositivos),
                            backgroundColor: [laranja, ciano, rosa],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        cutout: '62%',
                        plugins: {
                            legend: { position: 'bottom', labels: { padding: 14, usePointStyle: true, pointStyle: 'circle' } }
                        }
                    }
                });
            }

            // Barras horizontais: top páginas
            var elPaginas = document.getElementById('chartPaginas');
            if (elPaginas) {
                new Chart(elPaginas, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Js(labelsPaginas)),
                        datasets: [{
                            label: 'Visitas',
                            data: @System.Text.Json.JsonSerializer.Serialize(dadosPaginas),
                            backgroundColor: 'rgba(247,100,0,0.75)',
                            borderRadius: 6,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { beginAtZero: true, ticks: { precision: 0 } },
                            y: { ticks: { font: { size: 10.5 } } }
                        }
                    }
                });
            }

            // Rosca: fontes de tráfego
            var elFontes = document.getElementById('chartFontes');
            if (elFontes) {
                new Chart(elFontes, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(Js(labelsFontes)),
                        datasets: [{
                            data: @System.Text.Json.JsonSerializer.Serialize(dadosFontes),
                            backgroundColor: [verde, ciano, amarelo, laranja],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        cutout: '62%',
                        plugins: {
                            legend: { position: 'bottom', labels: { padding: 14, usePointStyle: true, pointStyle: 'circle' } }
                        }
                    }
                });
            }

            // Barras: maravilhas mais clicadas
            var elMaravilhas = document.getElementById('chartMaravilhas');
            if (elMaravilhas) {
                new Chart(elMaravilhas, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Js(labelsMaravilhas)),
                        datasets: [{
                            label: 'Cliques',
                            data: @System.Text.Json.JsonSerializer.Serialize(dadosMaravilhas),
                            backgroundColor: 'rgba(230,43,52,0.75)',
                            borderRadius: 6,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { beginAtZero: true, ticks: { precision: 0 } },
                            y: { ticks: { font: { size: 11 } } }
                        }
                    }
                });
            }

            // Barras: cliques por evento
            var elEventos = document.getElementById('chartEventos');
            if (elEventos) {
                var labelsEventos = @Html.Raw(Js(Model.Resumo.TopEventos.Select(e => e.Rotulo).ToList()));
                var dadosEventos = @Html.Raw(Js(Model.Resumo.TopEventos.Select(e => e.Quantidade).ToList()));
                new Chart(elEventos, {
                    type: 'doughnut',
                    data: {
                        labels: labelsEventos,
                        datasets: [{
                            data: dadosEventos,
                            backgroundColor: [laranja, ciano, verde, amarelo, rosa, vermelho],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        cutout: '62%',
                        plugins: {
                            legend: { position: 'bottom', labels: { padding: 10, usePointStyle: true, pointStyle: 'circle', font: { size: 10.5 } } }
                        }
                    }
                });
            }
        })();
    </script>
}

@functions {
    /// <summary>
    /// Serializa dados para o Chart.js dentro de &lt;script&gt;: o Razor codificaria as
    /// aspas do JSON (&amp;quot;), quebrando o JS; Html.Raw + escape de "&lt;/" evita
    /// tanto o encoding quanto a saída do bloco de script.
    /// </summary>
    private static string Js(object valor)
    {
        return System.Text.Json.JsonSerializer.Serialize(valor, valor.GetType()).Replace("</", "<\\/");
    }
}
