@model EstatisticaDto
@{ ViewData["Title"] = "Nova estatística"; }
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Nova estatística</h1>
        <p class="painel-page-desc">Ex.: "350" + legenda "Anos de história".</p>
    </div>
</div>

<form class="painel-form" asp-action="Criar" method="post">
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-field">
        <label asp-for="Valor"></label>
        <input asp-for="Valor" class="painel-input" maxlength="20" placeholder="Ex.: 350" />
        <span asp-validation-for="Valor" class="field-validation-error"></span>
    </div>

    @{
        ViewData["CampoSelect"] = "Legenda";
    }
    @await Html.PartialAsync("_SeletorChave", Model.Legenda ?? string.Empty)

    <div class="painel-form-grid">
        <div class="painel-field">
            <label asp-for="Ordem"></label>
            <input asp-for="Ordem" class="painel-input" type="number" />
        </div>
        <div class="painel-field">
            <label class="painel-checkbox">
                <input asp-for="Ativo" /> Ativa no portal
            </label>
        </div>
    </div>

    <div class="painel-form-actions">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar</button>
        <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
    </div>
</form>
