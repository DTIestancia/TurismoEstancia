@model EventoDto
@{
    ViewData["Title"] = "Novo evento";
    ViewData["AreaAtiva"] = "agenda";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Novo evento</h1>
        <p class="painel-page-desc">Agenda um evento no portal.</p>
    </div>

<form class="painel-form" asp-action="Criar" method="post">
        <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

        <div class="painel-field">
            <label asp-for="Titulo"></label>
            <input asp-for="Titulo" class="painel-input" maxlength="150" />
            <span asp-validation-for="Titulo" class="field-validation-error"></span>
        </div>

        <div class="painel-field">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" class="painel-textarea"></textarea>
        </div>

        <div class="painel-field">
            <label asp-for="Local"></label>
            <input asp-for="Local" class="painel-input" maxlength="200" />
        </div>

        <div class="painel-form-grid">
            <div class="painel-field">
                <label asp-for="DataInicio"></label>
                <input asp-for="DataInicio" class="painel-input" type="datetime-local" />
            </div>
            <div class="painel-field">
                <label asp-for="DataFim"></label>
                <input asp-for="DataFim" class="painel-input" type="datetime-local" />
            </div>
        </div>

        <div class="painel-form-grid">
            <div class="painel-field">
                <label asp-for="Ordem"></label>
                <input asp-for="Ordem" class="painel-input" type="number" />
            </div>
            <div class="painel-field">
                <label class="painel-checkbox">
                    <input asp-for="Ativo" /> Ativo no portal
                </label>
            </div>
        </div>

        <div class="painel-form-actions">
            <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar</button>
            <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
        </div>
    </form>
