@model IReadOnlyList<EventoDto>
@{
    ViewData["Title"] = "Eventos";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Eventos</h1>
        <p class="painel-page-desc">Agenda de eventos exibida no portal, com exportação .ics para calendários.</p>
    </div>
    <a class="btn-painel btn-painel--primary" asp-action="Criar"><i data-lucide="plus"></i> Novo evento</a>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Local</th>
                    <th>Início</th>
                    <th>Término</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Titulo</strong></td>
                        <td>@(item.Local ?? "—")</td>
                        <td>@item.DataInicio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.DataFim.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--grey")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-controller="Evento" asp-action="Ics" asp-route-id="@item.Id" target="_blank" title="Exportar .ics"><i data-lucide="calendar-plus"></i></a>
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Excluir o evento '@item.Titulo'?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs"><i data-lucide="trash-2"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhum evento cadastrado.</div>
    }
</div>
