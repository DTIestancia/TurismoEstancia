@model IReadOnlyList<GaleriaCategoriaDto>
@{
    ViewData["Title"] = "Galeria";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Galeria de Estância</h1>
        <p class="painel-page-desc">Categorias dinâmicas de fotos — cada categoria vira uma página em /galeria/{chave}. As fotos são otimizadas no upload (máx. 1600px + thumbnail), sem pesar o banco.</p>
    </div>
    <button type="button" class="btn-painel btn-painel--primary js-abrir-criar" data-titulo="Nova categoria" data-url="@Url.Action("Criar")">
        <i data-lucide="plus"></i> Nova categoria
    </button>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Capa</th>
                    <th>Nome</th>
                    <th>Chave</th>
                    <th>Fotos</th>
                    <th>Ordem</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.CapaArquivoId is long capaId)
                            {
                                <img class="painel-item-thumb" src="/arquivo/@capaId" alt="Capa de @item.Nome" />
                            }
                            else
                            {
                                <span class="painel-item-thumb" style="display:inline-flex;align-items:center;justify-content:center;color:var(--color-white--30);"><i data-lucide="image"></i></span>
                            }
                        </td>
                        <td>
                            <strong>@item.Nome</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Descricao))
                            {
                                <div class="painel-hint">@item.Descricao</div>
                            }
                        </td>
                        <td><code>@item.Chave</code></td>
                        <td>@item.QuantidadeFotos</td>
                        <td>@item.Ordem</td>
                        <td>
                            <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--grey")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Fotos" asp-route-id="@item.Id" title="Gerenciar fotos da categoria"><i data-lucide="images"></i> Fotos</a>
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Excluir a categoria '@item.Nome'? Todas as fotos dela serão removidas.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs"><i data-lucide="trash-2"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhuma categoria cadastrada — crie a primeira para começar a galeria.</div>
    }
</div>
