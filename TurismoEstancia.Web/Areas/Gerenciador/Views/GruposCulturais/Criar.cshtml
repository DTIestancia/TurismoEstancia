@model GrupoCulturalDto
@{
    ViewData["Title"] = "Novo grupo cultural";
    ViewData["AreaAtiva"] = "cultura";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Novo grupo cultural</h1>
        <p class="painel-page-desc">Preencha os dados do grupo para a seção Cultura.</p>
    </div>
</div>

<form class="painel-form" asp-action="Criar" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

        <div class="painel-field">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" class="painel-input" maxlength="150" />
            <span asp-validation-for="Nome" class="field-validation-error"></span>
        </div>

        <div class="painel-field">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" class="painel-input" rows="4" maxlength="2000" placeholder="Texto exibido na página de detalhe do portal."></textarea>
            <span asp-validation-for="Descricao" class="field-validation-error"></span>
        </div>

        <div class="painel-form-grid">
            <div class="painel-field">
                <label asp-for="Ordem"></label>
                <input asp-for="Ordem" class="painel-input" type="number" />
            </div>
            <div class="painel-field">
                <label>Imagem do grupo</label>
                <input type="file" name="imagem" accept="image/*" class="painel-input" />
                <span class="painel-hint">Usada no card e na página de detalhe (opcional).</span>
            </div>
        </div>

        <div class="painel-field">
            <label class="painel-checkbox">
                <input asp-for="Ativo" /> Ativo no portal
            </label>
        </div>

        <div class="painel-form-actions">
            <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar</button>
            <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
        </div>
    </form>
