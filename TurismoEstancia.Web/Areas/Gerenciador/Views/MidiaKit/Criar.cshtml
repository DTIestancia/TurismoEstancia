@model MidiaKitItemDto
@{
    ViewData["Title"] = "Novo item do mídia kit";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Novo item do mídia kit</h1>
        <p class="painel-page-desc">Material para download em /midia-kit.</p>
    </div>
</div>

<form class="painel-form" asp-action="Criar" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-field">
        <label asp-for="Titulo"></label>
        <input asp-for="Titulo" class="painel-input" maxlength="180" placeholder="Ex.: Logotipo oficial (PNG)" />
        <span asp-validation-for="Titulo" class="field-validation-error"></span>
    </div>

    <div class="painel-field">
        <label asp-for="Descricao"></label>
        <textarea asp-for="Descricao" class="painel-textarea" maxlength="1000" placeholder="Ex.: Versão horizontal em alta resolução, fundo transparente"></textarea>
    </div>

    <div class="painel-field">
        <label>Arquivo para download</label>
        <input type="file" name="arquivo" class="painel-input" />
        <span class="painel-hint">Qualquer tipo: PNG, JPG, PDF, ZIP... (limite ~60 MB).</span>
    </div>

    <div class="painel-form-grid">
        <div class="painel-field">
            <label asp-for="Ordem"></label>
            <input asp-for="Ordem" class="painel-input" type="number" />
        </div>
        <div class="painel-field">
            <label class="painel-checkbox">
                <input asp-for="Ativo" /> Ativo no portal
            </label>
        </div>
    </div>

    <div class="painel-form-actions">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar</button>
        <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
    </div>
</form>
