@model IReadOnlyList<MidiaKitItemDto>
@{
    ViewData["Title"] = "Mídia kit";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Mídia kit</h1>
        <p class="painel-page-desc">Materiais para imprensa e parceiros exibidos em /midia-kit (logotipos, fotos, manuais...).</p>
    </div>
    <div style="display:flex;gap:8px;">
        <button type="button" class="btn-painel btn-painel--primary js-abrir-criar" data-titulo="Novo item do mídia kit" data-url="@Url.Action("Criar")">
            <i data-lucide="plus"></i> Novo item
        </button>
    </div>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Arquivo</th>
                    <th>Ordem</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Titulo</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Descricao))
                            {
                                <br /><span class="painel-hint" style="margin:0;">@item.Descricao</span>
                            }
                        </td>
                        <td>@(item.ArquivoNome ?? "—")</td>
                        <td>@item.Ordem</td>
                        <td>
                            <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--grey")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                @if (item.Ativo)
                                {
                                    <form asp-action="Ocultar" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Ocultar o item '@item.Titulo'? Ele sai do portal, mas pode ser reativado.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--xs" title="Ocultar"><i data-lucide="eye-off"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Reativar" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--xs" title="Reativar"><i data-lucide="eye"></i></button>
                                    </form>
                                }
                                <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Excluir DEFINITIVAMENTE o item '@item.Titulo'? O arquivo será apagado.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs" title="Excluir definitivamente"><i data-lucide="trash-2"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhum item cadastrado. Clique em "Novo item" para começar.</div>
    }
</div>
