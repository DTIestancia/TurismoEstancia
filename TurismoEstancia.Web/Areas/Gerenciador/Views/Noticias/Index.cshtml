@model IReadOnlyList<NoticiaDto>
@{
    ViewData["Title"] = "Notícias";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Notícias</h1>
        <p class="painel-page-desc">Publicações exibidas em /Noticias no portal.</p>
    </div>
    <button type="button" class="btn-painel btn-painel--primary js-abrir-criar" data-titulo="Nova notícia" data-url="@Url.Action("Criar")">
        <i data-lucide="plus"></i> Nova notícia
    </button>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Imagem</th>
                    <th>Título</th>
                    <th>Data</th>
                    <th>Publicada</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.ImagemArquivoId is long imgId)
                            {
                                <img class="painel-item-thumb" src="@Url.Content($"~/arquivo/{imgId}")" alt="" />
                            }
                        </td>
                        <td><strong>@item.Titulo</strong></td>
                        <td>@item.DataPublicacao.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="painel-badge @(item.Publicada ? "painel-badge--green" : "painel-badge--grey")">
                                @(item.Publicada ? "Publicada" : "Rascunho")
                            </span>
                        </td>
                        <td>
                            <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--red")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <button type="button" class="btn-painel btn-painel--ghost btn-painel--xs js-compartilhar-noticia"
                                        data-url="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.PathBase)/Noticias/Detalhe/@item.Slug"
                                        data-titulo="@item.Titulo"
                                        title="Copiar link + legenda para postar no Instagram">
                                    <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                                        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                                    </svg>
                                </button>
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-page="/Noticias/Detalhe" asp-route-slug="@item.Slug" target="_blank" title="Ver no portal"><i data-lucide="eye"></i></a>
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Excluir a notícia '@item.Titulo'?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs"><i data-lucide="trash-2"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhuma notícia cadastrada.</div>
    }
    else
    {
        @await Html.PartialAsync("_Paginacao", new PaginacaoViewModel
        {
            PaginaAtual = (int)(ViewData["PaginaAtual"] ?? 1),
            TotalPaginas = (int)(ViewData["PaginasTotal"] ?? 1),
            UrlBase = Url.Action("Index", "Noticias") ?? "/Gerenciador/Noticias"
        })
    }
</div>

@section Scripts {
    <script>
        // Compartilhar a notícia no Instagram direto do Gerenciador: copia
        // link + legenda prontos para colar (e abre a folha do sistema no
        // celular, com o Instagram entre as opções).
        (function () {
            var botoes = document.querySelectorAll('.js-compartilhar-noticia');
            if (!botoes.length) return;

            function toast(mensagem) {
                var el = document.createElement('div');
                el.textContent = mensagem;
                el.style.cssText = 'position:fixed;bottom:22px;left:50%;transform:translateX(-50%);z-index:9999;background:#0B1726;color:#fff;border:1px solid rgba(255,255,255,0.16);padding:10px 18px;border-radius:999px;font-size:13px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.45);pointer-events:none;';
                document.body.appendChild(el);
                setTimeout(function () { el.remove(); }, 2800);
            }

            botoes.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = btn.getAttribute('data-url');
                    var titulo = btn.getAttribute('data-titulo');
                    var texto = titulo + '\n' + url + '\n#VemPraEstância #Estância';

                    function copiado() {
                        toast('Link e legenda copiados — cole no Instagram 📸');
                    }

                    if (navigator.share) {
                        navigator.share({ title: titulo, text: texto, url: url }).catch(function () { /* cancelado */ });
                    }
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(texto).then(copiado).catch(function () { /* sem permissão */ });
                    } else {
                        var ta = document.createElement('textarea');
                        ta.value = texto;
                        ta.style.position = 'fixed';
                        ta.style.opacity = '0';
                        document.body.appendChild(ta);
                        ta.select();
                        try { document.execCommand('copy'); copiado(); } catch (e) { /* noop */ }
                        ta.remove();
                    }
                });
            });
        })();
    </script>
}
