@model PlanejeCategoriaDto
@{ ViewData["Title"] = "Nova categoria"; }
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Nova categoria</h1>
        <p class="painel-page-desc">Filtro da seção "Planeje sua viagem".</p>
    </div>
</div>

<form class="painel-form" asp-action="Criar" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-field">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="painel-input" maxlength="100" placeholder="Ex.: Onde ficar" />
        <span asp-validation-for="Nome" class="field-validation-error"></span>
    </div>

    <div class="painel-field">
        <label asp-for="Descricao"></label>
        <textarea asp-for="Descricao" class="painel-textarea" maxlength="500" placeholder="Ex.: Hotéis, pousadas e hospedagens"></textarea>
    </div>

    <div class="painel-form-grid">
        @await Html.PartialAsync("_SeletorIcone", Model.Icone, new ViewDataDictionary(ViewData) { ["Placeholder"] = "bed-double, utensils..." })
        <div class="painel-field">
            <label asp-for="Cor"></label>
            <input asp-for="Cor" class="painel-input" maxlength="20" placeholder="#F97E31" />
        </div>
    </div>

    <div class="painel-field">
        <label>Imagem padrão da categoria (opcional)</label>
        <input type="file" name="imagemPadrao" accept="image/*" class="painel-input" />
        <span class="painel-hint">Usada nos cards sem foto própria.</span>
    </div>

    <div class="painel-form-grid">
        <div class="painel-field">
            <label asp-for="Ordem"></label>
            <input asp-for="Ordem" class="painel-input" type="number" />
        </div>
        <div class="painel-field">
            <label class="painel-checkbox">
                <input asp-for="Ativo" /> Ativo no portal
            </label>
        </div>
    </div>

    <div class="painel-form-actions">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar</button>
        <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
    </div>
</form>
