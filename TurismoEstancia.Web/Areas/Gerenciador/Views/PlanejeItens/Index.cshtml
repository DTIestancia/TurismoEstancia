@model IReadOnlyList<PlanejeItemDto>
@{
    ViewData["Title"] = "Locais do Planeje";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Locais do Planeje</h1>
        <p class="painel-page-desc">Cards da seção "Planeje sua viagem" (hotéis, restaurantes, serviços...).</p>
    </div>
    <button type="button" class="btn-painel btn-painel--primary js-abrir-criar" data-titulo="Novo local" data-url="@Url.Action("Criar")">
        <i data-lucide="plus"></i> Novo local
    </button>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Imagem</th>
                    <th>Título</th>
                    <th>Categoria</th>
                    <th>Ordem</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.ImagemArquivoId is long imgId)
                            {
                                <img class="painel-item-thumb" src="@Url.Content($"~/arquivo/{imgId}")" alt="" />
                            }
                            else if (item.CategoriaImagemPadraoArquivoId is long padraoId)
                            {
                                <img class="painel-item-thumb" src="@Url.Content($"~/arquivo/{padraoId}")" alt="" title="Imagem padrão da categoria" />
                            }
                        </td>
                        <td><strong>@item.Titulo</strong></td>
                        <td>@(item.CategoriaNome ?? "—")</td>
                        <td>@item.Ordem</td>
                        <td>
                            <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--grey")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                @if (item.Ativo)
                                {
                                    <form asp-action="Ocultar" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Ocultar o local '@item.Titulo'? Ele sai do portal, mas pode ser reativado.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--xs" title="Ocultar"><i data-lucide="eye-off"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Reativar" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--xs" title="Reativar"><i data-lucide="eye"></i></button>
                                    </form>
                                }
                                <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Excluir DEFINITIVAMENTE o local '@item.Titulo'? A imagem será apagada.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs" title="Excluir definitivamente"><i data-lucide="trash-2"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhum local cadastrado.</div>
    }
    else
    {
        @await Html.PartialAsync("_Paginacao", new PaginacaoViewModel
        {
            PaginaAtual = (int)(ViewData["PaginaAtual"] ?? 1),
            TotalPaginas = (int)(ViewData["PaginasTotal"] ?? 1),
            UrlBase = Url.Action("Index", "PlanejeItens")
        })
    }
</div>
