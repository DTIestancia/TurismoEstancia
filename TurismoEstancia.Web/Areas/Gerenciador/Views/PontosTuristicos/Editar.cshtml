@model PontoTuristicoDto
@{
    ViewData["Title"] = "Editar ponto turístico";
    var categorias = (IReadOnlyList<CategoriaPontoTuristicoDto>)ViewBag.Categorias;
    var capaAtual = Model.Midias.FirstOrDefault(m => m.Tipo == TipoMidia.Capa);
    var pictoAtual = Model.Midias.FirstOrDefault(m => m.Tipo == TipoMidia.Pictograma);
    var galeria = Model.Midias.Where(m => m.Tipo == TipoMidia.Galeria).OrderBy(m => m.Ordem).ToList();
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Editar ponto turístico</h1>
        <p class="painel-page-desc">Capa, pictograma, galeria e horários no mesmo formulário.</p>
    </div>
</div>

<form class="painel-form" asp-action="Editar" method="post" enctype="multipart/form-data" style="max-width:920px;">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-form-grid">
        <div class="painel-field">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" class="painel-input" maxlength="150" />
            <span asp-validation-for="Nome" class="field-validation-error"></span>
        </div>
        <div class="painel-field">
            <label asp-for="CategoriaId"></label>
            <select asp-for="CategoriaId" class="painel-select">
                <option value="">— Selecione —</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id" data-maravilha="@(c.ApresentarEmMaravilhas ? "true" : "false")">@c.Nome</option>
                }
            </select>
            <span asp-validation-for="CategoriaId" class="field-validation-error"></span>
        </div>
    </div>

    <div class="painel-field">
        <label asp-for="Descricao"></label>
        <textarea asp-for="Descricao" class="painel-textarea"></textarea>
    </div>

    <div class="painel-field">
        <label asp-for="Detalhe"></label>
        <textarea asp-for="Detalhe" class="painel-textarea"></textarea>
        <span class="painel-hint">Texto detalhado exibido no modal do mapa.</span>
    </div>

    <div class="painel-form-grid">
        <div class="painel-field">
            <label asp-for="Tag"></label>
            <input asp-for="Tag" class="painel-input" maxlength="60" />
        </div>
        <div class="painel-field">
            <label asp-for="Icone"></label>
            <input asp-for="Icone" class="painel-input" maxlength="40" />
        </div>
    </div>

    <div class="painel-field">
        <label asp-for="Endereco"></label>
        <input asp-for="Endereco" class="painel-input" maxlength="300" />
    </div>

    <div class="painel-field">
        <label asp-for="ComoChegar"></label>
        <textarea asp-for="ComoChegar" class="painel-textarea"></textarea>
    </div>

    <div class="painel-field" id="campoPosicaoMapa">
        <label>Posição no mapa</label>
        <div style="display:flex; gap:8px; margin-bottom:10px;">
            <button type="button" class="btn-painel btn-painel--primary btn-painel--xs" id="tabMapaDesktop">Desktop</button>
            <button type="button" class="btn-painel btn-painel--ghost btn-painel--xs" id="tabMapaMobile">Mobile</button>
        </div>
        <div class="painel-mapa" id="painelMapaDesktop" role="application" aria-label="Mapa desktop — clique para posicionar">
            @if (ViewBag.MapaImagemId != null)
            {
                <img src="@Url.Content($"~/arquivo/{ViewBag.MapaImagemId}")" alt="Mapa desktop" class="painel-mapa-imagem" />
            }
            else
            {
                <div class="custom-map-terrain" aria-hidden="true">
                    <div class="terrain-circle" style="width:260px;height:260px;top:8%;left:6%;"></div>
                    <div class="terrain-circle" style="width:180px;height:180px;top:22%;left:16%;"></div>
                    <div class="terrain-circle" style="width:340px;height:340px;top:38%;left:48%;"></div>
                    <div class="terrain-circle" style="width:220px;height:220px;top:58%;left:22%;"></div>
                    <div class="terrain-circle" style="width:300px;height:300px;top:28%;left:68%;"></div>
                    <div class="terrain-circle" style="width:160px;height:160px;top:68%;left:64%;"></div>
                </div>
                <div class="custom-map-grid" aria-hidden="true"></div>
                <div class="custom-map-river" aria-hidden="true"></div>
            }
            <div class="painel-mapa-vazio" id="painelMapaVazioDesktop">👆 Clique para posicionar (desktop)</div>
            <div class="painel-mapa-marcador" id="painelMapaMarcadorDesktop" hidden></div>
        </div>
        <div class="painel-mapa" id="painelMapaMobile" role="application" aria-label="Mapa mobile — clique para posicionar" style="display:none;">
            @if (ViewBag.MapaImagemIdMobile != null)
            {
                <img src="@Url.Content($"~/arquivo/{ViewBag.MapaImagemIdMobile}")" alt="Mapa mobile" class="painel-mapa-imagem" />
            }
            else if (ViewBag.MapaImagemId != null)
            {
                <img src="@Url.Content($"~/arquivo/{ViewBag.MapaImagemId}")" alt="Mapa mobile (fallback desktop)" class="painel-mapa-imagem" style="opacity:0.85;" />
                <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(10,22,40,0.55); color:white; font-size:12px; font-weight:600; text-align:center; padding:12px;">Sem imagem mobile — usando desktop como prévia</div>
            }
            else
            {
                <div class="custom-map-terrain" aria-hidden="true">
                    <div class="terrain-circle" style="width:220px;height:220px;top:10%;left:8%;"></div>
                    <div class="terrain-circle" style="width:340px;height:340px;top:40%;left:10%;"></div>
                </div>
                <div class="custom-map-grid" aria-hidden="true"></div>
                <div class="custom-map-river" aria-hidden="true"></div>
            }
            <div class="painel-mapa-vazio" id="painelMapaVazioMobile">👆 Clique para posicionar (mobile)</div>
            <div class="painel-mapa-marcador" id="painelMapaMarcadorMobile" hidden></div>
        </div>
        <div class="painel-form-grid" style="margin-top:10px;">
            <div class="painel-field">
                <label>Desktop — <span style="font-weight:400; text-transform:none;">LeftPercent</span></label>
                <input asp-for="LeftPercent" class="painel-input" type="number" min="0" max="100" />
            </div>
            <div class="painel-field">
                <label>TopPercent</label>
                <input asp-for="TopPercent" class="painel-input" type="number" min="0" max="100" />
            </div>
            <div class="painel-field">
                <label>Mobile — LeftPercentMobile</label>
                <input asp-for="LeftPercentMobile" class="painel-input" type="number" min="0" max="100" />
                <span class="painel-hint">Se 0, usa o desktop no celular.</span>
            </div>
            <div class="painel-field">
                <label>TopPercentMobile</label>
                <input asp-for="TopPercentMobile" class="painel-input" type="number" min="0" max="100" />
            </div>
        </div>
        <span class="painel-hint">Use as abas Desktop/Mobile acima para posicionar separadamente. Clique no mapa correspondente.</span>
    </div>

    <div class="painel-form-grid">
        <div class="painel-field">
            <label asp-for="Ordem"></label>
            <input asp-for="Ordem" class="painel-input" type="number" />
        </div>
        <div class="painel-field">
            <label class="painel-checkbox">
                <input asp-for="ExibirNoMapa" /> Exibir no mapa
            </label>
        </div>
        <div class="painel-field">
            <label class="painel-checkbox">
                <input asp-for="Ativo" /> Ativo no portal
            </label>
        </div>
    </div>

    <div class="painel-card-title"><i data-lucide="image"></i> Mídias</div>
    <div class="painel-form-grid">
        <div class="painel-field">
            <label>Capa</label>
            @if (capaAtual is not null)
            {
                <img src="@Url.Content($"~/arquivo/{capaAtual.ArquivoId}")" alt="" style="max-width:200px;border-radius:10px;border:1px solid var(--color-white--12);margin-bottom:6px;" />
            }
            <input type="file" name="capa" accept="image/*" class="painel-input" />
        </div>
        <div class="painel-field">
            <label>Pictograma</label>
            @if (pictoAtual is not null)
            {
                <img src="@Url.Content($"~/arquivo/{pictoAtual.ArquivoId}")" alt="" style="max-width:80px;border-radius:10px;border:1px solid var(--color-white--12);margin-bottom:6px;" />
            }
            <input type="file" name="pictograma" accept="image/*" class="painel-input" />
        </div>
    </div>

    <div class="painel-field">
        <label>Galeria (adicionar fotos)</label>
        @if (galeria.Count > 0)
        {
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px;">
                @foreach (var g in galeria)
                {
                    <img src="@Url.Content($"~/arquivo/{g.ArquivoId}")" alt="" style="width:70px;height:70px;object-fit:cover;border-radius:10px;border:1px solid var(--color-white--12);" />
                }
            </div>
        }
        <input type="file" name="galeria" accept="image/*" class="painel-input" multiple />
        <span class="painel-hint">Selecione para adicionar à galeria (as existentes são mantidas).</span>
    </div>

    <div class="painel-card-title"><i data-lucide="clock"></i> Horários de funcionamento</div>
    @{
        var dias = new[] { "Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado" };
        for (var d = 0; d < 7; d++)
        {
            var dia = (DiaSemana)d;
            var horario = Model.Horarios.FirstOrDefault(h => h.DiaSemana == dia);
            var fechado = horario?.Fechado == true;
            var inicio = horario?.HoraInicio?.ToString("HH:mm") ?? "08:00";
            var fim = horario?.HoraFim?.ToString("HH:mm") ?? "18:00";
            <div class="painel-form-grid" style="align-items:center;border:1px solid var(--color-white--8);border-radius:10px;padding:10px 12px;">
                <div class="painel-field" style="flex-direction:row;align-items:center;gap:10px;">
                    <label style="margin:0;width:110px;">@dias[d]</label>
                    <label class="painel-checkbox" style="margin:0;">
                        <input type="checkbox" id="fechado-@d" data-dia="@d" name="horarios[@d].Fechado" value="true" @(fechado ? "checked" : "") /> Fechado
                    </label>
                </div>
                <div class="painel-field" id="horario-@d" @(fechado ? "style=display:none;" : "")>
                    <div style="display:flex;gap:8px;">
                        <input type="time" name="horarios[@d].HoraInicio" value="@inicio" class="painel-input" />
                        <input type="time" name="horarios[@d].HoraFim" value="@fim" class="painel-input" />
                    </div>
                    <input type="hidden" name="horarios[@d].DiaSemana" value="@((int)dia)" />
                </div>
            </div>
        }
    }

    <div class="painel-form-actions">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar alterações</button>
        <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
    </div>
</form>

@section Scripts {
    <script>
        document.querySelectorAll('[id^="fechado-"]').forEach(function (chk) {
            chk.addEventListener('change', function () {
                var campo = document.getElementById('horario-' + chk.getAttribute('data-dia'));
                campo.style.display = chk.checked ? 'none' : '';
            });
        });

        (function(){
            var btnD=document.getElementById('tabMapaDesktop'), btnM=document.getElementById('tabMapaMobile');
            var mapD=document.getElementById('painelMapaDesktop'), mapM=document.getElementById('painelMapaMobile');
            if(btnD&&btnM&&mapD&&mapM){
                btnD.addEventListener('click',function(){ mapD.style.display=''; mapM.style.display='none'; btnD.classList.add('btn-painel--primary');btnD.classList.remove('btn-painel--ghost');btnM.classList.add('btn-painel--ghost');btnM.classList.remove('btn-painel--primary');});
                btnM.addEventListener('click',function(){ mapD.style.display='none'; mapM.style.display=''; btnM.classList.add('btn-painel--primary');btnM.classList.remove('btn-painel--ghost');btnD.classList.add('btn-painel--ghost');btnD.classList.remove('btn-painel--primary');});
            }
        })();
        if (window.InicializarMapaPonto) {
            window.InicializarMapaPonto({
                mapaId: 'painelMapaDesktop',
                marcadorId: 'painelMapaMarcadorDesktop',
                vazioId: 'painelMapaVazioDesktop',
                leftId: 'LeftPercent',
                topId: 'TopPercent'
            });
            window.InicializarMapaPonto({
                mapaId: 'painelMapaMobile',
                marcadorId: 'painelMapaMarcadorMobile',
                vazioId: 'painelMapaVazioMobile',
                leftId: 'LeftPercentMobile',
                topId: 'TopPercentMobile'
            });
        }
    </script>
}
