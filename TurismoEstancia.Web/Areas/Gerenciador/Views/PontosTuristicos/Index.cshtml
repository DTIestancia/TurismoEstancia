@model IReadOnlyList<PontoTuristicoDto>
@{
    ViewData["Title"] = "Pontos turísticos";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Pontos turísticos</h1>
        <p class="painel-page-desc">Locais exibidos no mapa e nas maravilhas do portal.</p>
    </div>
    <a class="btn-painel btn-painel--primary" asp-action="Criar"><i data-lucide="plus"></i> Novo ponto</a>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Imagem</th>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Mapa</th>
                    <th>Ordem</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.CapaArquivoId is long capaId)
                            {
                                <img class="painel-item-thumb" src="/arquivo/@capaId" alt="" />
                            }
                        </td>
                        <td><strong>@item.Nome</strong></td>
                        <td>@(item.CategoriaNome ?? "—")</td>
                        <td>
                            <span class="painel-badge @(item.ExibirNoMapa ? "painel-badge--cyan" : "painel-badge--grey")">
                                @(item.ExibirNoMapa ? "Sim" : "Não")
                            </span>
                        </td>
                        <td>@item.Ordem</td>
                        <td>
                            <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--red")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                @if (item.Ativo)
                                {
                                    <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Desativar o ponto '@item.Nome'? Ele sai do portal.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs" title="Desativar"><i data-lucide="eye-off"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Reativar" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--xs" title="Reativar"><i data-lucide="eye"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhum ponto turístico cadastrado.</div>
    }
</div>
