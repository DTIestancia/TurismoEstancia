@model IReadOnlyList<PontoTuristicoDto>
@{
    ViewData["Title"] = "Pontos turísticos";
    var contexto = (ViewData["ContextoPontos"] as string) ?? "todos";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Pontos turísticos</h1>
        <p class="painel-page-desc">Locais do portal. As 7 Maravilhas e o Mapa mostram conjuntos diferentes: o mapa inclui também restaurantes, hotéis, praias e demais pontos.</p>
    </div>
    <button type="button" class="btn-painel btn-painel--primary js-abrir-criar" data-titulo="Novo ponto turístico" data-url="@Url.Action("Criar")">
        <i data-lucide="plus"></i> Novo ponto
    </button>
</div>

<div class="painel-periodo" style="margin-bottom:16px;">
    <a asp-action="Index" asp-route-contexto="" class="@(contexto == "todos" ? "active" : "")">Todos</a>
    <a asp-action="Index" asp-route-contexto="maravilhas" class="@(contexto == "maravilhas" ? "active" : "")"><i data-lucide="gem" style="width:13px;height:13px;"></i> 7 Maravilhas</a>
    <a asp-action="Index" asp-route-contexto="mapa" class="@(contexto == "mapa" ? "active" : "")"><i data-lucide="map" style="width:13px;height:13px;"></i> Mapa (todos)</a>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Imagem</th>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Maravilha</th>
                    <th>Mapa</th>
                    <th>Ordem</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.CapaArquivoId is long capaId)
                            {
                                <img class="painel-item-thumb" src="@Url.Content($"~/arquivo/{capaId}")" alt="" />
                            }
                        </td>
                        <td><strong>@item.Nome</strong></td>
                        <td>@(item.CategoriaNome ?? "—")</td>
                        <td>
                            <span class="painel-badge @(item.CategoriaApresentarEmMaravilhas ? "painel-badge--yellow" : "painel-badge--grey")">
                                @(item.CategoriaApresentarEmMaravilhas ? "Sim" : "Não")
                            </span>
                        </td>
                        <td>
                            <span class="painel-badge @(item.ExibirNoMapa ? "painel-badge--cyan" : "painel-badge--grey")">
                                @(item.ExibirNoMapa ? "Sim" : "Não")
                            </span>
                        </td>
                        <td>@item.Ordem</td>
                        <td>
                            <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--red")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                @if (item.Ativo)
                                {
                                    <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Desativar o ponto '@item.Nome'? Ele sai do portal.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs" title="Desativar"><i data-lucide="eye-off"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Reativar" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--xs" title="Reativar"><i data-lucide="eye"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhum ponto turístico cadastrado.</div>
    }
</div>
