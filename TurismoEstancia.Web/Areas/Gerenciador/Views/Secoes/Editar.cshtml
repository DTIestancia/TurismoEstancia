@model AreaSiteViewModel
@{
    ViewData["Title"] = Model.Titulo;
    var ehHero = Model.Area == "hero";
    var ehCidade = Model.Area == "cidade";
    var ehMapa = Model.Area == "mapa";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">@Model.Titulo</h1>
        <p class="painel-page-desc">@Model.Descricao</p>
    </div>
</div>

@{
    ViewData["AreaAtiva"] = Model.Area;
    ViewData["VerSecaoUrl"] = Model.VerSecaoUrl;
}

@if (Model.Itens is { } blocoItens)
{
    <div class="painel-card">
        <div class="painel-card-title"><i data-lucide="@blocoItens.Icone"></i> @blocoItens.Titulo
            <span class="painel-badge painel-badge--grey" style="margin-left:auto;">@blocoItens.Itens.Count</span>
        </div>
        <p style="font-size:12.5px;color:var(--color-white--45);margin:0 0 14px;">Veja o que já está cadastrado nesta área e cadastre novos itens sem sair da página.</p>

        @if (blocoItens.Itens.Count == 0)
        {
            <div class="painel-empty" style="padding:18px 10px;margin-bottom:14px;">Nada cadastrado ainda — clique em "@blocoItens.RotuloBotao" para começar.</div>
        }
        else
        {
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px;margin-bottom:14px;">
                @foreach (var item in blocoItens.Itens)
                {
                    <div style="display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:12px;background:var(--color-white--5);border:1px solid var(--color-white--10);">
                        @if (item.ImagemArquivoId is long imgId)
                        {
                            <img src="@Url.Content($"~/arquivo/{imgId}")" alt="" style="width:42px;height:42px;border-radius:9px;object-fit:cover;flex-shrink:0;border:1px solid var(--color-white--10);" />
                        }
                        else
                        {
                            <div style="width:42px;height:42px;border-radius:9px;background:var(--color-white--8);display:flex;align-items:center;justify-content:center;color:var(--color-white--40);flex-shrink:0;"><i data-lucide="@blocoItens.Icone" style="width:18px;height:18px;"></i></div>
                        }
                        <div style="min-width:0;flex:1;">
                            <div style="font-size:13px;font-weight:600;color:var(--color-white-solid);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@item.Nome</div>
                            @if (!string.IsNullOrWhiteSpace(item.Detalhe))
                            {
                                <div style="font-size:11.5px;color:var(--color-white--45);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@item.Detalhe</div>
                            }
                        </div>
                        <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--grey")">@(item.Ativo ? "Ativo" : "Inativo")</span>
                    </div>
                }
            </div>
        }

        <div class="painel-actions">
            <button type="button" class="btn-painel btn-painel--primary js-abrir-criar"
                    data-titulo="@blocoItens.RotuloBotao" data-url="@blocoItens.UrlCriar">
                <i data-lucide="plus"></i> @blocoItens.RotuloBotao
            </button>
            <a class="btn-painel btn-painel--ghost" href="@blocoItens.UrlLista" target="_blank" rel="noopener">
                <i data-lucide="list"></i> Ver todos (lista completa)
            </a>
        </div>
    </div>
}

@if (ehHero)
{
    <div class="painel-card" style="margin-bottom:18px;">
        <div class="painel-card-title"><i data-lucide="video"></i> Vídeo do hero (fundo em tela cheia)</div>
        <p style="font-size:13px;color:var(--color-white--55);margin:4px 0 14px;">O vídeo inicia junto com a página em loop e ocupa o fundo do hero. Envie um MP4 leve (720p, &lt;12 MB, H.264) otimizado para carregamento instantâneo.</p>

        @if (Model.VideoArquivoId is long videoId)
        {
            <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin-bottom:14px;">
                <video src="@Url.Content($"~/arquivo/{videoId}")" controls muted playsinline preload="metadata"
                       style="max-width:320px;width:100%;border-radius:12px;border:1px solid var(--color-white--15);"></video>
                <form asp-action="RemoverVideoHero" method="post" class="js-confirm" data-confirm="Remover o vídeo do hero? O fundo ficará sem mídia até enviar outro.">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs"><i data-lucide="trash-2"></i> Remover vídeo</button>
                </form>
            </div>
        }
        else
        {
            <div class="painel-empty" style="padding:18px 10px;margin-bottom:14px;">Nenhum vídeo no hero — envie um MP4 para ativar o fundo em vídeo.</div>
        }

        <form asp-action="SalvarVideoHero" method="post" enctype="multipart/form-data" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;">
            @Html.AntiForgeryToken()
            <div class="painel-field" style="flex:1;min-width:220px;margin:0;">
                <label>Vídeo (MP4)</label>
                <input type="file" name="arquivo" accept="video/mp4,video/*" class="painel-input" required />
                <span class="painel-hint">Recomendado: 720p, H.264, &lt;12 MB para iniciar junto com a página. O vídeo inicia automaticamente com a página.</span>
            </div>
            <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="upload"></i> Enviar vídeo</button>
        </form>
    </div>
}

<form class="painel-form" asp-action="Salvar@(char.ToUpperInvariant(Model.Area[0]) + Model.Area[1..])" method="post" enctype="multipart/form-data">
    <input type="hidden" name="Area" value="@Model.Area" />
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-card" style="padding:22px;">
        @for (var i = 0; i < Model.Textos.Count; i++)
        {
            var campo = Model.Textos[i];
            <div class="painel-field">
                <label for="Textos_@(i)__Valor">@campo.Nome</label>
                <textarea name="Textos[@i].Valor" id="Textos_@(i)__Valor" class="painel-textarea" style="min-height:90px;">@campo.Valor</textarea>
                <input type="hidden" name="Textos[@i].Chave" value="@campo.Chave" />
                <input type="hidden" name="Textos[@i].Nome" value="@campo.Nome" />
                @if (!string.IsNullOrWhiteSpace(campo.Dica))
                {
                    <span class="painel-hint">@campo.Dica</span>
                }
            </div>
        }

        @for (var j = 0; j < Model.Imagens.Count; j++)
        {
            var img = Model.Imagens[j];
            <div class="painel-field">
                <label>@img.Nome</label>
                @if (img.ArquivoId is long arquivoId)
                {
                    <div style="margin-bottom:10px;">
                        <img src="@Url.Content($"~/arquivo/{arquivoId}")" alt="@img.Nome" style="max-width:300px;border-radius:12px;border:1px solid var(--color-white--15);" />
                        <div style="font-size:12px;color:var(--color-white--50);margin-top:4px;">Imagem atual — enviar outra substitui.</div>
                    </div>
                }
                <input type="file" name="imagem_@(img.Chave)" accept="image/*" class="painel-input" />
                <input type="hidden" name="Imagens[@j].Chave" value="@img.Chave" />
                <input type="hidden" name="Imagens[@j].Nome" value="@img.Nome" />
            </div>
        }

        @if (ehMapa)
        {
            var mapaImgId = Model.Imagens.FirstOrDefault(i => i.Chave == "mapa-imagem")?.ArquivoId;
            var mapaSrc = mapaImgId is long mid ? Url.Content($"~/arquivo/{mid}") : null;
            <div class="painel-field">
                <label>Posição e zoom do mapa</label>
                <div class="ajuste-imagem" id="ajusteMapa" data-ajuste-imagem data-zoom="@Model.MapaImagemZoom" data-x="@Model.MapaImagemPosX" data-y="@Model.MapaImagemPosY" data-src="@mapaSrc">
                    <div class="ajuste-imagem-previa">
                        <div class="ajuste-imagem-janela">
                            <img class="ajuste-imagem-img" alt="Prévia do recorte do mapa" />
                            <span class="ajuste-imagem-vazio">
                                <i data-lucide="image-plus" class="icon-xl"></i>
                                Selecione o PNG do mapa para ajustar.
                            </span>
                        </div>
                    </div>
                    <div class="ajuste-imagem-controles">
                        <div class="ajuste-imagem-controle">
                            <label for="mapaZoom">Zoom <span class="ajuste-imagem-valor" data-rotulo="zoom">@(Model.MapaImagemZoom)%</span></label>
                            <input type="range" id="mapaZoom" class="ajuste-imagem-range" data-alvo="zoom" min="100" max="250" step="5" value="@Model.MapaImagemZoom" />
                        </div>
                        <div class="ajuste-imagem-controle">
                            <label for="mapaY">Posição vertical <span class="ajuste-imagem-valor" data-rotulo="y">@(Model.MapaImagemPosY)%</span></label>
                            <input type="range" id="mapaY" class="ajuste-imagem-range" data-alvo="y" min="0" max="100" step="5" value="@Model.MapaImagemPosY" />
                        </div>
                        <div class="ajuste-imagem-controle">
                            <label for="mapaX">Posição horizontal <span class="ajuste-imagem-valor" data-rotulo="x">@(Model.MapaImagemPosX)%</span></label>
                            <input type="range" id="mapaX" class="ajuste-imagem-range" data-alvo="x" min="0" max="100" step="5" value="@Model.MapaImagemPosX" />
                        </div>
                        <button type="button" class="btn-painel btn-painel--ghost btn-painel--xs" data-ajuste-reset>
                            <i data-lucide="rotate-ccw"></i> Redefinir
                        </button>
                    </div>
                    <input type="hidden" name="MapaImagemZoom" value="@Model.MapaImagemZoom" />
                    <input type="hidden" name="MapaImagemPosX" value="@Model.MapaImagemPosX" />
                    <input type="hidden" name="MapaImagemPosY" value="@Model.MapaImagemPosY" />
                </div>
                <span class="painel-hint">Sugestão: 1600×900px (16:9), PNG com fundo transparente, até 1 MB. Use zoom e posição para enquadrar o município — a prévia é exatamente o que aparece no portal, com os pins por cima.</span>
            </div>
            <script>
                (function(){
                    var caixa = document.getElementById('ajusteMapa');
                    if(!caixa || caixa.dataset.inicializado==="1") return;
                    caixa.dataset.inicializado="1";
                    var img=caixa.querySelector('.ajuste-imagem-img'), vazio=caixa.querySelector('.ajuste-imagem-vazio');
                    var hZoom=caixa.querySelector('input[name="MapaImagemZoom"]'), hX=caixa.querySelector('input[name="MapaImagemPosX"]'), hY=caixa.querySelector('input[name="MapaImagemPosY"]');
                    var rZoom=caixa.querySelector('input[data-alvo="zoom"]'), rX=caixa.querySelector('input[data-alvo="x"]'), rY=caixa.querySelector('input[data-alvo="y"]');
                    var lZoom=caixa.querySelector('[data-rotulo="zoom"]'), lX=caixa.querySelector('[data-rotulo="x"]'), lY=caixa.querySelector('[data-rotulo="y"]');
                    var zoom=parseInt(caixa.getAttribute('data-zoom'),10)||100, x=parseInt(caixa.getAttribute('data-x'),10), y=parseInt(caixa.getAttribute('data-y'),10);
                    if(isNaN(x)) x=50; if(isNaN(y)) y=50;
                    var src=caixa.getAttribute('data-src')||'';
                    function aplicar(){ if(src){ img.src=src; img.style.width='100%'; img.style.height='100%'; img.style.objectFit='contain'; img.style.objectPosition=x+'% '+y+'%'; img.style.transformOrigin=x+'% '+y+'%'; img.style.transform='scale('+(zoom/100)+')'; img.style.display='block'; vazio.style.display='none'; } else { img.style.display='none'; vazio.style.display=''; } lZoom.textContent=zoom+'%'; lX.textContent=x+'%'; lY.textContent=y+'%'; hZoom.value=zoom; hX.value=x; hY.value=y; }
                    function sync(){ rZoom.value=zoom; rX.value=x; rY.value=y; }
                    rZoom.addEventListener('input',function(){ zoom=parseInt(rZoom.value,10)||100; aplicar(); });
                    rX.addEventListener('input',function(){ x=parseInt(rX.value,10)||50; aplicar(); });
                    rY.addEventListener('input',function(){ y=parseInt(rY.value,10)||50; aplicar(); });
                    var rst=caixa.querySelector('[data-ajuste-reset]'); if(rst) rst.addEventListener('click',function(){ zoom=100; x=50; y=50; sync(); aplicar(); });
                    var form=caixa.closest('form'); var arq=form&&form.querySelector('input[name="imagem_mapa-imagem"]'); if(arq) arq.addEventListener('change',function(){ var f=arq.files&&arq.files[0]; if(!f) return; var r=new FileReader(); r.onload=function(){ src=r.result; aplicar(); }; r.readAsDataURL(f); });
                    sync(); aplicar();
                })();
            </script>
        }

        @if (Model.Links.Count > 0)
        {
            <div style="border-top:1px solid var(--color-white--10);margin-top:20px;padding-top:16px;">
                <div class="painel-preview-title" style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--color-white--55);margin-bottom:12px;">Itens desta área</div>
                <p style="font-size:12.5px;color:var(--color-white--45);margin:0 0 12px;">Veja o que já está cadastrado e crie novos itens nas telas próprias (abrem em nova aba).</p>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    @foreach (var link in Model.Links)
                    {
                        <a href="@link.Url" target="_blank" rel="noopener" class="btn-painel btn-painel--ghost" style="justify-content:flex-start;text-align:left;">
                            <i data-lucide="@link.Icone"></i>
                            <span>
                                <strong>@link.Titulo</strong>
                                <small style="display:block;color:var(--color-white--50);font-size:12px;">@link.Descricao</small>
                            </span>
                            <i data-lucide="chevron-right" style="margin-left:auto;"></i>
                        </a>
                    }
                </div>
            </div>
        }

        @if (ehCidade && Model.Estatisticas.Count > 0)
        {
            <div style="border-top:1px solid var(--color-white--10);margin-top:20px;padding-top:16px;">
                <div class="painel-preview-title" style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--color-white--55);margin-bottom:12px;">Estatísticas atuais</div>
                <div style="display:flex;flex-wrap:wrap;gap:10px;">
                    @foreach (var est in Model.Estatisticas)
                    {
                        <span class="tema-chip" style="--cor: var(--color-orange-48);">@est.Valor · @est.Legenda</span>
                    }
                </div>
            </div>
        }
    </div>

    <div class="painel-form-actions" style="margin-top:16px;">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar @Model.Titulo</button>
        <a class="btn-painel btn-painel--ghost" asp-action="Index" asp-controller="Dashboard" asp-area="Gerenciador"><i data-lucide="x"></i> Cancelar</a>
    </div>
</form>

<dialog class="painel-preview-dialog" id="previewDialog" aria-label="Prévia da seção no portal">
    <div class="painel-preview-dialog-inner">
        <div class="painel-preview-dialog-header">
            <h3 class="painel-preview-dialog-title"><i data-lucide="eye"></i> Prévia — @Model.Titulo</h3>
            <div class="painel-preview-dialog-acoes">
                <button type="button" class="painel-preview-dialog-close" id="previewDialogFechar" title="Fechar">
                    <i data-lucide="x"></i>
                </button>
            </div>
        </div>
        <div class="painel-preview-dialog-corpo">
            <iframe id="previewDialogFrame" src="about:blank" title="Prévia da seção no portal"></iframe>
        </div>
    </div>
</dialog>

@section Scripts {
    <script>
        // Preview ao vivo dos campos de texto que aceitam HTML (reuso do painel.js).
        @for (var i = 0; i < Model.Textos.Count; i++)
        {
            <text>if (window.PrevisualizarTexto) window.PrevisualizarTexto('Textos_@(i)__Valor');</text>
        }

        // Modal de prévia: mostra a seção do portal (com os textos/imagens que
        // serão salvos) num iframe apontando para a âncora da área — sem sair
        // da página e sem recarregar o Gerenciador.
        (function () {
            var dialog = document.getElementById('previewDialog');
            var frame = document.getElementById('previewDialogFrame');
            if (!dialog || !frame) return;

            function abrir(url) {
                if (!url) return;
                frame.setAttribute('src', url);
                if (typeof dialog.showModal === 'function') dialog.showModal();
                else dialog.setAttribute('open', '');
                if (window.lucide) window.lucide.createIcons();
            }

            // Botão "Prévia" na subnav (definido pelo partial _SubnavAreas).
            var botaoPreview = document.getElementById('jsAbrirPreview');
            if (botaoPreview) botaoPreview.addEventListener('click', function () { abrir(botaoPreview.getAttribute('data-url')); });

            document.getElementById('previewDialogFechar').addEventListener('click', function () {
                window.FecharDialogPainel('previewDialog');
            });
            dialog.addEventListener('click', function (ev) {
                if (ev.target === dialog) window.FecharDialogPainel('previewDialog'); // clique no backdrop
            });
            document.addEventListener('keydown', function (ev) {
                if (ev.key === 'Escape' && dialog.open) window.FecharDialogPainel('previewDialog');
            });
        })();
    </script>
}
