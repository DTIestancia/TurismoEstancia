@model SlideDto
@{ ViewData["Title"] = "Editar slide"; }
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Editar slide</h1>
        <p class="painel-page-desc">Atualize a imagem (opcional — mantém a atual se vazio).</p>
    </div>
</div>

<form class="painel-form" asp-action="Editar" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ImagemArquivoId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-field">
        <label>Imagem atual</label>
        <img src="@Url.Content($"~/arquivo/{Model.ImagemArquivoId}")" alt="" style="max-width:320px;border-radius:12px;border:1px solid var(--color-white--12);" />
    </div>

    <div class="painel-field">
        <label>Substituir imagem (opcional)</label>
        <input type="file" name="imagem" accept="image/*" class="painel-input" />
    </div>

    <div class="painel-field">
        <label asp-for="Titulo"></label>
        <input asp-for="Titulo" class="painel-input" maxlength="120" />
    </div>

    <div class="painel-form-grid">
        <div class="painel-field">
            <label asp-for="Ordem"></label>
            <input asp-for="Ordem" class="painel-input" type="number" />
        </div>
        <div class="painel-field">
            <label class="painel-checkbox">
                <input asp-for="Ativo" /> Ativo no portal
            </label>
        </div>
    </div>

    <div class="painel-form-actions">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar alterações</button>
        <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
    </div>
</form>
