@model IReadOnlyList<TagCulturalDto>
@{
    ViewData["Title"] = "Tags culturais";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Tags culturais</h1>
        <p class="painel-page-desc">Etiquetas usadas na seção Cultura do portal.</p>
    </div>
    <button type="button" class="btn-painel btn-painel--primary js-abrir-criar" data-titulo="Nova tag cultural" data-url="@Url.Action("Criar")">
        <i data-lucide="plus"></i> Nova tag
    </button>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Ordem</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Nome</strong></td>
                        <td>@item.Ordem</td>
                        <td>
                            <span class="painel-badge @(item.Ativo ? "painel-badge--green" : "painel-badge--grey")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <a class="btn-painel btn-painel--ghost btn-painel--xs" asp-action="Editar" asp-route-id="@item.Id"><i data-lucide="pencil"></i> Editar</a>
                                @if (item.Ativo)
                                {
                                    <form asp-action="Ocultar" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Ocultar a tag '@item.Nome'? Ela sai do portal, mas pode ser reativada.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--xs" title="Ocultar"><i data-lucide="eye-off"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Reativar" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--xs" title="Reativar"><i data-lucide="eye"></i></button>
                                    </form>
                                }
                                <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="js-confirm" data-confirm="Excluir DEFINITIVAMENTE a tag '@item.Nome'? A imagem será apagada.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs" title="Excluir definitivamente"><i data-lucide="trash-2"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhuma tag cadastrada. Clique em "Nova tag" para começar.</div>
    }
</div>
