@model TemaViewModel
@{
    ViewData["Title"] = "Tema e cores";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Tema e cores</h1>
        <p class="painel-page-desc">Personalize a paleta oficial do portal (Barco de Fogo). As cores valem na hora, sem recompilar o site.</p>
    </div>
</div>

@if (Model.Personalizado)
{
    <div class="painel-alert painel-alert--ok" style="margin-bottom:18px;">
        <i data-lucide="palette"></i> Tema personalizado ativo. Para voltar à paleta oficial, use "Restaurar paleta oficial".
    </div>
}

<form class="painel-form" asp-action="Salvar" method="post">
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-card" style="padding:22px;">
        <div class="tema-grid">
            <div class="tema-item">
                <label class="tema-label" asp-for="Vermelho">Vermelho</label>
                <div class="tema-input">
                    <input type="color" asp-for="Vermelho" class="tema-color" data-cor="vermelho" />
                    <input type="text" asp-for="Vermelho" class="painel-input tema-hex" data-hex="vermelho" maxlength="7" />
                </div>
                <small class="tema-dica">Identidade: Nossa Cidade, avisos, fim dos gradientes.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="Laranja">Laranja</label>
                <div class="tema-input">
                    <input type="color" asp-for="Laranja" class="tema-color" data-cor="laranja" />
                    <input type="text" asp-for="Laranja" class="painel-input tema-hex" data-hex="laranja" maxlength="7" />
                </div>
                <small class="tema-dica">Identidade: 7 Maravilhas, botões principais, CTAs.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="Amarelo">Amarelo</label>
                <div class="tema-input">
                    <input type="color" asp-for="Amarelo" class="tema-color" data-cor="amarelo" />
                    <input type="text" asp-for="Amarelo" class="painel-input tema-hex" data-hex="amarelo" maxlength="7" />
                </div>
                <small class="tema-dica">Identidade: Gastronomia, títulos de hero, selo das Maravilhas.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="Verde">Verde</label>
                <div class="tema-input">
                    <input type="color" asp-for="Verde" class="tema-color" data-cor="verde" />
                    <input type="text" asp-for="Verde" class="painel-input tema-hex" data-hex="verde" maxlength="7" />
                </div>
                <small class="tema-dica">Identidade: Grupos Populares, sucesso, destaques de História.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="Azul">Azul</label>
                <div class="tema-input">
                    <input type="color" asp-for="Azul" class="tema-color" data-cor="azul" />
                    <input type="text" asp-for="Azul" class="painel-input tema-hex" data-hex="azul" maxlength="7" />
                </div>
                <small class="tema-dica">Identidade: Notícias, Roteiros, Mapa, links.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="Rosa">Rosa</label>
                <div class="tema-input">
                    <input type="color" asp-for="Rosa" class="tema-color" data-cor="rosa" />
                    <input type="text" asp-for="Rosa" class="painel-input tema-hex" data-hex="rosa" maxlength="7" />
                </div>
                <small class="tema-dica">Identidade: Cultura, partículas do hero.</small>
            </div>
        </div>

        <!-- Pré-visualização ao vivo -->
        <div class="tema-preview" style="margin-top:22px;border-top:1px solid var(--color-white--10);padding-top:18px;">
            <div class="tema-preview-title">Pré-visualização</div>
            <div class="tema-preview-bar">
                <span class="tema-chip" data-preview="vermelho">Nossa Cidade</span>
                <span class="tema-chip" data-preview="rosa">Cultura</span>
                <span class="tema-chip" data-preview="amarelo">Gastronomia</span>
                <span class="tema-chip" data-preview="verde">Grupos</span>
                <span class="tema-chip" data-preview="laranja">7 Maravilhas</span>
                <span class="tema-chip" data-preview="azul">Notícias</span>
            </div>
            <div class="tema-preview-cta" data-preview="laranja">Explorar as 7 Maravilhas</div>
        </div>
    </div>

    <div class="painel-card" style="padding:22px;margin-top:18px;">
        <div class="tema-preview-title">Cores das seções da home</div>
        <p class="painel-page-desc" style="margin:0 0 16px;">Cada faixa abaixo é uma seção do portal, na mesma ordem da página. A ondulação entre duas seções usa a cor da seção de baixo — mude a cor e a onda acompanha sozinha.</p>
        <div class="tema-grid">
            <div class="tema-item">
                <label class="tema-label" asp-for="SecaoHistoria">Nossa Cidade</label>
                <div class="tema-input">
                    <input type="color" asp-for="SecaoHistoria" class="tema-color" data-cor="secao-historia" />
                    <input type="text" asp-for="SecaoHistoria" class="painel-input tema-hex" data-hex="secao-historia" maxlength="7" />
                </div>
                <small class="tema-dica">Fundo laranja da história + onda do hero.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="SecaoConheca">Conheça Estância</label>
                <div class="tema-input">
                    <input type="color" asp-for="SecaoConheca" class="tema-color" data-cor="secao-conheca" />
                    <input type="text" asp-for="SecaoConheca" class="painel-input tema-hex" data-hex="secao-conheca" maxlength="7" />
                </div>
                <small class="tema-dica">Base escura do carrossel de fotos.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="SecaoMaravilhas">7 Maravilhas</label>
                <div class="tema-input">
                    <input type="color" asp-for="SecaoMaravilhas" class="tema-color" data-cor="secao-maravilhas" />
                    <input type="text" asp-for="SecaoMaravilhas" class="painel-input tema-hex" data-hex="secao-maravilhas" maxlength="7" />
                </div>
                <small class="tema-dica">Fundo do baralho + onda de saída do Conheça.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="SecaoAgenda">Agenda</label>
                <div class="tema-input">
                    <input type="color" asp-for="SecaoAgenda" class="tema-color" data-cor="secao-agenda" />
                    <input type="text" asp-for="SecaoAgenda" class="painel-input tema-hex" data-hex="secao-agenda" maxlength="7" />
                </div>
                <small class="tema-dica">Substitui o degradê vinho por cor chapada.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="SecaoRoteiros">Planeje sua viagem</label>
                <div class="tema-input">
                    <input type="color" asp-for="SecaoRoteiros" class="tema-color" data-cor="secao-roteiros" />
                    <input type="text" asp-for="SecaoRoteiros" class="painel-input tema-hex" data-hex="secao-roteiros" maxlength="7" />
                </div>
                <small class="tema-dica">Fundo dos cards de roteiros + onda da Agenda.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="SecaoNoticias">Notícias e Blog</label>
                <div class="tema-input">
                    <input type="color" asp-for="SecaoNoticias" class="tema-color" data-cor="secao-noticias" />
                    <input type="text" asp-for="SecaoNoticias" class="painel-input tema-hex" data-hex="secao-noticias" maxlength="7" />
                </div>
                <small class="tema-dica">Seção clara — textos escuros se adaptam.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="SecaoMapa">Mapa</label>
                <div class="tema-input">
                    <input type="color" asp-for="SecaoMapa" class="tema-color" data-cor="secao-mapa" />
                    <input type="text" asp-for="SecaoMapa" class="painel-input tema-hex" data-hex="secao-mapa" maxlength="7" />
                </div>
                <small class="tema-dica">Fundo do mapa + onda de saída do Blog.</small>
            </div>
            <div class="tema-item">
                <label class="tema-label" asp-for="SecaoRodape">Rodapé</label>
                <div class="tema-input">
                    <input type="color" asp-for="SecaoRodape" class="tema-color" data-cor="secao-rodape" />
                    <input type="text" asp-for="SecaoRodape" class="painel-input tema-hex" data-hex="secao-rodape" maxlength="7" />
                </div>
                <small class="tema-dica">Fecha a página + onda de saída do Mapa.</small>
            </div>
        </div>

        <!-- Pré-visualização das seções na ordem da home -->
        <div class="tema-preview" style="margin-top:22px;border-top:1px solid var(--color-white--10);padding-top:18px;">
            <div class="tema-preview-title">Ordem das seções (como no portal)</div>
            <div class="tema-secoes-preview">
                <div class="tema-secao-faixa" data-preview="secao-historia"><span>Nossa Cidade</span></div>
                <div class="tema-secao-faixa" data-preview="secao-conheca"><span>Conheça Estância</span></div>
                <div class="tema-secao-faixa" data-preview="secao-maravilhas"><span>7 Maravilhas</span></div>
                <div class="tema-secao-faixa" data-preview="secao-agenda"><span>Agenda</span></div>
                <div class="tema-secao-faixa" data-preview="secao-roteiros"><span>Planeje sua viagem</span></div>
                <div class="tema-secao-faixa" data-preview="secao-noticias"><span>Notícias e Blog</span></div>
                <div class="tema-secao-faixa" data-preview="secao-mapa"><span>Mapa</span></div>
                <div class="tema-secao-faixa" data-preview="secao-rodape"><span>Rodapé</span></div>
            </div>
        </div>
    </div>

    <div class="painel-form-actions" style="margin-top:16px;">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Salvar tema</button>
        <button type="submit" class="btn-painel btn-painel--ghost" formaction="@Url.Action("Restaurar")" formmethod="post"
                onclick="return confirm('Restaurar a paleta oficial? As cores personalizadas serão apagadas.');">
            <i data-lucide="rotate-ccw"></i> Restaurar paleta oficial
        </button>
        <a class="btn-painel btn-painel--ghost" asp-area="Gerenciador" asp-controller="Configuracoes" asp-action="Index"><i data-lucide="settings"></i> Ver configurações</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            // Sincroniza color picker <-> campo hex e atualiza o preview ao vivo.
            function sincronizar(nome, hex) {
                var cor = document.querySelector('[data-cor="' + nome + '"]');
                var hexEl = document.querySelector('[data-hex="' + nome + '"]');
                if (cor && hexEl) {
                    cor.value = hex;
                    hexEl.value = hex;
                }
                document.querySelectorAll('[data-preview="' + nome + '"]').forEach(function (el) {
                    el.style.setProperty('--cor', hex);
                });
            }

            document.querySelectorAll('.tema-color').forEach(function (input) {
                input.addEventListener('input', function () { sincronizar(input.dataset.cor, input.value); });
            });
            document.querySelectorAll('.tema-hex').forEach(function (input) {
                input.addEventListener('input', function () {
                    var v = input.value.trim();
                    if (/^#[0-9a-fA-F]{6}$/.test(v)) sincronizar(input.dataset.hex, v);
                });
            });
            // Preview inicial com os valores carregados do servidor
            document.querySelectorAll('.tema-color').forEach(function (input) {
                sincronizar(input.dataset.cor, input.value);
            });
        })();
    </script>
}
