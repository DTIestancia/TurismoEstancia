@model CriarUsuarioViewModel
@{ ViewData["Title"] = "Novo usuário"; }
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Novo usuário</h1>
        <p class="painel-page-desc">Cria uma conta para acesso ao painel (sem auto-registro público).</p>
    </div>
</div>

<form class="painel-form" asp-action="Criar" method="post">
    <div asp-validation-summary="ModelOnly" class="painel-alert painel-alert--erro"></div>

    <div class="painel-field">
        <label asp-for="NomeCompleto"></label>
        <input asp-for="NomeCompleto" class="painel-input" maxlength="150" />
        <span asp-validation-for="NomeCompleto" class="field-validation-error"></span>
    </div>

    <div class="painel-field">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="painel-input" autocomplete="off" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <div class="painel-field">
        <label asp-for="Senha"></label>
        <input asp-for="Senha" class="painel-input" autocomplete="new-password" />
        <span class="painel-hint">Mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo.</span>
        <span asp-validation-for="Senha" class="field-validation-error"></span>
    </div>

    <div class="painel-field">
        <label asp-for="Perfil"></label>
        <select asp-for="Perfil" class="painel-select">
            <option value="@Perfis.Operador">Operador — eventos e newsletter</option>
            <option value="@Perfis.Gerenciador">Gerenciador — acesso total ao CMS</option>
        </select>
    </div>

    <div class="painel-form-actions">
        <button type="submit" class="btn-painel btn-painel--primary"><i data-lucide="check"></i> Criar usuário</button>
        <a class="btn-painel btn-painel--ghost" asp-action="Index"><i data-lucide="x"></i> Cancelar</a>
    </div>
</form>
