@model IReadOnlyList<UsuarioItemViewModel>
@{
    ViewData["Title"] = "Usuários";
}
<div class="painel-page-header">
    <div>
        <h1 class="painel-page-title">Usuários</h1>
        <p class="painel-page-desc">Contas de acesso ao painel. Perfis: Gerenciador (acesso total) e Operador (eventos + newsletter).</p>
    </div>
    <a class="btn-painel btn-painel--primary" asp-action="Criar"><i data-lucide="user-plus"></i> Novo usuário</a>
</div>

<div class="painel-card">
    <div class="painel-table-wrap">
        <table class="painel-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Perfil</th>
                    <th>Status</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Usuario.NomeCompleto</strong></td>
                        <td>@item.Usuario.Email</td>
                        <td>
                            <span class="painel-badge @(item.Perfil == Perfis.Gerenciador ? "painel-badge--orange" : "painel-badge--cyan")">
                                @item.Perfil
                            </span>
                        </td>
                        <td>
                            <span class="painel-badge @(item.Usuario.LockoutEnabled && item.Usuario.LockoutEnd is not null && item.Usuario.LockoutEnd > DateTimeOffset.UtcNow ? "painel-badge--red" : "painel-badge--green")">
                                @(item.Usuario.LockoutEnabled && item.Usuario.LockoutEnd is not null && item.Usuario.LockoutEnd > DateTimeOffset.UtcNow ? "Bloqueado" : "Ativo")
                            </span>
                        </td>
                        <td>
                            <div class="painel-actions" style="justify-content:flex-end;">
                                <form asp-action="Excluir" asp-route-id="@item.Usuario.Id" method="post" class="js-confirm" data-confirm="Excluir o usuário @item.Usuario.Email? A ação não pode ser desfeita.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-painel btn-painel--danger btn-painel--xs"><i data-lucide="trash-2"></i> Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="painel-empty">Nenhum usuário cadastrado. Crie a primeira conta de Gerenciador para operar o painel.</div>
    }
</div>
