@page "{slug}"
@model TurismoEstancia.Web.Pages.Noticias.DetalheModel
@{
    ViewData["Title"] = Model.Noticia?.Titulo ?? "Notícia não encontrada";
}
@await Html.PartialAsync("_PaginasHeader")
<main class="news-detail page-public">
    @if (Model.Noticia is null)
    {
        <div class="news-container">
            <div class="news-empty">Notícia não encontrada ou não publicada.</div>
            <p style="text-align:center;margin-top:16px;"><a class="btn-primary" asp-page="Index">← Voltar às notícias</a></p>
        </div>
    }
    else
    {
        <article class="news-article">
            <header class="news-article-header">
                <div class="pill pill-white" style="background:var(--color-white--15);">
                    <span style="color:var(--color-white-solid);font-size:12px;font-weight:700;">@Model.Noticia.DataPublicacao.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</span>
                </div>
                <h1 class="news-article-title">@Model.Noticia.Titulo</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Noticia.Resumo))
                {
                    <p class="news-article-resumo">@Model.Noticia.Resumo</p>
                }
            </header>
            @if (Model.Noticia.ImagemArquivoId is long imgId)
            {
                <div class="news-article-img-wrap">
                    <img class="news-article-img" src="@Url.Content($"~/arquivo/{imgId}")" alt="@Model.Noticia.Titulo"
                         style="--noticia-zoom:@(Model.Noticia.ImagemZoom)%;object-position:@(Model.Noticia.ImagemPosicaoX)% @(Model.Noticia.ImagemPosicaoY)%;transform-origin:@(Model.Noticia.ImagemPosicaoX)% @(Model.Noticia.ImagemPosicaoY)%;" />
                </div>
            }
            <div class="news-article-body">
                @Html.Raw(Model.Noticia.Corpo)
            </div>
            @if (Model.Galeria is not null)
            {
                var totalFotos = Model.GaleriaFotos.Count;
                const int fotosVisiveis = 6;
                <section class="news-galeria" data-section="galeria">
                    <div class="news-galeria-header">
                        <h2 class="news-galeria-titulo"><i data-lucide="camera" class="icon-lg"></i> Galeria: @Model.Galeria.Nome</h2>
                        @if (totalFotos > 0)
                        {
                            <button type="button" class="btn-primary js-ver-todas-fotos" data-abrir-em="0"
                                    data-track="galeria-categoria" data-track-nome="@Model.Galeria.Nome">
                                Ver todas as fotos @(totalFotos > fotosVisiveis ? $"({totalFotos})" : "") <i data-lucide="expand" class="icon-lg"></i>
                            </button>
                        }
                    </div>
                    @if (totalFotos > 0)
                    {
                        <div class="paginas-galeria-grid paginas-galeria-grid--fotos news-galeria-grid">
                            @for (var i = 0; i < totalFotos; i++)
                            {
                                var midia = Model.GaleriaFotos[i];
                                var thumb = midia.ArquivoThumbId ?? midia.ArquivoId;
                                <a class="galeria-item @(i >= fotosVisiveis ? "galeria-item--extra" : "")"
                                   href="@Url.Content($"~/arquivo/{midia.ArquivoId}")"
                                   data-full="@Url.Content($"~/arquivo/{midia.ArquivoId}")"
                                   data-titulo="@(midia.Titulo ?? Model.Galeria.Nome)"
                                   data-id="@midia.Id"
                                   data-like="@midia.Curtidas"
                                   data-views="@midia.Visualizacoes"
                                   data-track="galeria-foto" data-track-id="@midia.Id"
                                   aria-label="Ampliar foto: @(midia.Titulo ?? Model.Galeria.Nome)" title="@(midia.Titulo ?? Model.Galeria.Nome)">
                                    <img src="@Url.Content($"~/arquivo/{thumb}")" alt="@(midia.Titulo ?? Model.Galeria.Nome)" loading="lazy" decoding="async" />
                                    @if (i == fotosVisiveis - 1 && totalFotos > fotosVisiveis)
                                    {
                                        <span class="galeria-item-mais" data-abrir-em="@fotosVisiveis" role="button"
                                              aria-label="Ver as @(totalFotos - fotosVisiveis) fotos restantes">
                                            <span class="galeria-item-mais-num">+@(totalFotos - fotosVisiveis)</span>
                                            <span class="galeria-item-mais-rotulo">ver todas as fotos</span>
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(midia.Titulo))
                                    {
                                        <span class="galeria-item-legenda">@midia.Titulo</span>
                                    }
                                </a>
                            }
                        </div>
                    }
                </section>
            }
            <footer class="news-article-footer">
                <div class="news-share-row">
                    <button type="button" class="btn-secondary js-compartilhar-noticia"
                            data-url="@(Request.Scheme)://@(Request.Host)@(Request.PathBase)@Request.Path"
                            data-titulo="@Model.Noticia.Titulo"
                            title="Compartilhar no Instagram (copia link + legenda)">
                        <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                        </svg>
                        Compartilhar no Instagram
                    </button>
                    <a class="btn-primary" asp-page="Index"><i data-lucide="arrow-left" class="icon-lg"></i> Voltar às notícias</a>
                </div>
            </footer>
        </article>
    }

    <!-- Lightbox da galeria (mesmo padrão da página /galeria): navega por TODAS as fotos sem sair da notícia -->
    @await Html.PartialAsync("_LightboxGaleria")
</main>
@await Html.PartialAsync("_PaginasFooter")

@section Scripts {
    <script>
        // Galeria da notícia: "Ver todas as fotos" (botão do cabeçalho) e o
        // tile "+N" (6ª foto quando há mais de 6) abrem o lightbox na posição
        // pedida — o lightbox (portal.js) navega por TODAS as fotos, sem sair
        // da página. O .click() dispara o listener que o portal.js já registrou
        // em cada .galeria-item (o portal.js roda antes deste bloco).
        (function () {
            var itens = document.querySelectorAll('.news-galeria .galeria-item');
            if (!itens.length) return;

            function abrirNo(indice) {
                if (itens[indice]) itens[indice].click();
            }

            // Tile "+N fotos": abre na primeira foto extra (escondida).
            var tileMais = document.querySelector('.news-galeria .galeria-item-mais');
            if (tileMais) {
                tileMais.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    abrirNo(parseInt(tileMais.getAttribute('data-abrir-em'), 10) || 6);
                });
            }

            // Botão "Ver todas as fotos" do cabeçalho: abre na primeira foto.
            var botao = document.querySelector('.news-galeria .js-ver-todas-fotos');
            if (botao) {
                botao.addEventListener('click', function () {
                    abrirNo(parseInt(botao.getAttribute('data-abrir-em'), 10) || 0);
                });
            }
        })();
    </script>
    <script>
        // Compartilhar a notícia no Instagram: no celular abre a folha de
        // compartilhamento do sistema (Instagram entre as opções); no desktop
        // copia link + legenda prontos para colar no Instagram.
        (function () {
            var btn = document.querySelector('.js-compartilhar-noticia');
            if (!btn) return;
            var url = btn.getAttribute('data-url');
            var titulo = btn.getAttribute('data-titulo');
            var rotuloOriginal = btn.innerHTML;

            btn.addEventListener('click', function () {
                var texto = titulo + '\n' + url + '\n#VemPraEstância #Estância';

                function copiado() {
                    btn.innerHTML = '<svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Link e legenda copiados!';
                    setTimeout(function () { btn.innerHTML = rotuloOriginal; }, 2600);
                }

                // No celular, o sistema oferece o Instagram como destino.
                if (navigator.share) {
                    navigator.share({ title: titulo, text: texto, url: url }).catch(function () { /* cancelado */ });
                }

                // Sempre copia link + legenda (fallback no desktop e garantia no celular).
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(texto).then(copiado).catch(function () { /* sem permissão */ });
                } else {
                    var ta = document.createElement('textarea');
                    ta.value = texto;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    try { document.execCommand('copy'); copiado(); } catch (e) { /* noop */ }
                    ta.remove();
                }
            });
        })();
    </script>
}
