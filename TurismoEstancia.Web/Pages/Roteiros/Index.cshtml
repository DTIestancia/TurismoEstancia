@page
@model TurismoEstancia.Web.Pages.Roteiros.IndexModel
@{
    ViewData["Title"] = "Roteiros";
}
@await Html.PartialAsync("_PaginasHeader")
<main class="news-index page-public">
    <section class="news-hero">
        <div class="news-hero-inner">
            <div class="pill pill-white" style="background:var(--color-white--15);">
                <i data-lucide="map" class="icon-lg"></i>
                <span style="color:var(--color-white-solid);font-size:12px;font-weight:700;">Explore Estância</span>
            </div>
            <h1 class="news-hero-title">Roteiros <span style="color:#FCBB0F;">Turísticos</span></h1>
            <p class="news-hero-subtitle">Itinerários prontos para você viver o melhor de Estância.</p>
        </div>
    </section>

    <div class="news-container">
        @if (Model.Roteiros.Count == 0)
        {
            <div class="news-empty">Nenhum roteiro disponível ainda.</div>
        }
        else
        {
            <div class="news-grid">
                @foreach (var roteiro in Model.Roteiros)
                {
                    <a class="news-card" asp-page="Detalhe" asp-route-id="@roteiro.Id"
                       data-track="roteiro" data-track-id="@roteiro.Id" data-track-nome="@roteiro.Titulo">
                        @if (roteiro.ImagemArquivoId is long imgId)
                        {
                            <img class="news-card-img" src="/arquivo/@imgId" alt="@roteiro.Titulo" loading="lazy" />
                        }
                        <div class="news-card-body">
                            <div class="news-card-date">@roteiro.Itens.Count dia(s) de roteiro</div>
                            <h2 class="news-card-title">@roteiro.Titulo</h2>
                            @if (!string.IsNullOrWhiteSpace(roteiro.Descricao))
                            {
                                <p class="news-card-resumo">@roteiro.Descricao</p>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</main>
@await Html.PartialAsync("_PaginasFooter")
