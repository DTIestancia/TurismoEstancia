@{
    ViewData["Title"] = "Acesso negado";
    Layout = "_PainelLayout";
}
<div class="painel-card" style="max-width:560px;margin:60px auto;text-align:center;padding:48px 32px;">
    <div style="width:64px;height:64px;border-radius:16px;background:rgba(230,43,52,0.15);border:1px solid rgba(230,43,52,0.4);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
        <i data-lucide="shield-alert" style="color:#FF8A92;" width="30" height="30"></i>
    </div>
    <h1 style="font-family:'Fraunces',serif;font-size:24px;color:var(--color-white-solid);">Acesso negado</h1>
    <p style="margin-top:10px;font-size:14px;color:var(--color-white--60);max-width:420px;margin-left:auto;margin-right:auto;">
        Seu perfil não tem permissão para acessar esta área. Se você precisa deste recurso, solicite ao Gerenciador que ajuste seu perfil.
    </p>
    <div style="margin-top:24px;display:flex;gap:10px;justify-content:center;">
        <a class="btn-painel btn-painel--primary" asp-controller="Home" asp-action="Index"><i data-lucide="home"></i> Voltar ao início</a>
        <a class="btn-painel btn-painel--ghost" asp-controller="Home" asp-action="Index"><i data-lucide="arrow-left"></i> Portal</a>
    </div>
</div>
