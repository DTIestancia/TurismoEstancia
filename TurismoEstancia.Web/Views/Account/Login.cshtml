@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>Entrar - Painel Turismo Estância</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;1,9..144,400;1,9..144,700&family=Inter:wght@300;400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/painel.css" asp-append-version="true" />
</head>
<body class="painel-body">
    <div class="login-page">
        <div class="login-card">
            <div class="login-logo">
                @await Component.InvokeAsync("LogoSite", new { altura = 34 })
            </div>
            <h1 class="login-title">Painel de Gestão</h1>
            <p class="login-subtitle">Portal de Turismo de Estância/SE — acesso restrito à equipe.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="login-error">
                    @foreach (var erro in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@erro.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Login" method="post" class="login-form">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="painel-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="painel-input" autocomplete="username" autofocus />
                </div>
                <div class="painel-field">
                    <label asp-for="Senha"></label>
                    <input asp-for="Senha" class="painel-input" autocomplete="current-password" />
                </div>
                <label class="painel-checkbox" style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--color-white--75);">
                    <input asp-for="Lembrar" style="accent-color:var(--color-orange-48);" />
                    Manter conectado
                </label>
                <button type="submit" class="btn-painel btn-painel--primary" style="justify-content:center;padding:11px;">
                    <i data-lucide="log-in"></i> Entrar
                </button>
            </form>

            <p style="margin-top:22px;font-size:12px;color:var(--color-white--40);text-align:center;">
                Contas são criadas pela administração. Em caso de dúvida, fale com o Gerenciador.
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/lucide@1.27.0/dist/umd/lucide.min.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
