@model HomeViewModel
@{
    ViewData["Title"] = "Início";
    Layout = "_Layout";
}
@section Head {
    @if (Model.VideoArquivoId is long _vidHead)
    {
        <link rel="preload" as="video" href="@Url.Content($"~/arquivo/{_vidHead}")" type="video/mp4" fetchpriority="high" />
    }
    @if (Model.VideoArquivoIdMobile is long _mvidHead)
    {
        <link rel="preload" as="video" href="@Url.Content($"~/arquivo/{_mvidHead}")" type="video/mp4" media="(max-width: 767px)" />
    }
}

@await Html.PartialAsync("_Hero", Model)
@await Html.PartialAsync("_Historia", Model)
@await Html.PartialAsync("_ConhecaEstancia", Model)
@await Html.PartialAsync("_Maravilhas", Model)
@await Html.PartialAsync("_Agenda", Model)
@await Html.PartialAsync("_Roteiros", Model)
@await Html.PartialAsync("_Noticias", Model)
@await Html.PartialAsync("_Mapa", Model)
@await Html.PartialAsync("_Footer", Model)

@section Scripts {
    <script>
        // Dados do mapa injetados no Razor para o portal.js
        window.turismoEstancia = {
            mapa: @Html.Raw(Model.MapaJson)
        };
    </script>
}
