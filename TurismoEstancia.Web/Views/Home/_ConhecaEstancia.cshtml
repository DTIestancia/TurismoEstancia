@model HomeViewModel
@{
    var conhecaTitulo = Model.Conteudos.GetValueOrDefault("conheca-titulo",
        "Conheça <strong>Estância</strong>") ?? "";
    var conhecaDesc = Model.Conteudos.GetValueOrDefault("conheca-descricao",
        "Escolha um tema e deslize pelas fotos: história, cultura, gastronomia e experiências do Litoral de Estância.") ?? "";

    var temItens = Model.ConhecaEstancia.Any(t => t.Itens.Count > 0);

    var dadosJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ConhecaEstancia.Select(t => new
        {
            chave = t.Chave,
            rotulo = t.Rotulo,
            icone = t.Icone,
            itens = t.Itens.Select(i => new
            {
                nome = i.Nome,
                descricao = i.Descricao ?? "",
                imagem = i.ImagemArquivoId is long img ? Url.Content($"~/arquivo/{img}") : ""
            })
        }));
}

<section class="section-conheca section-divider" id="section-conheca" data-section="conheca">
    <div class="conheca-slides" id="conhecaSlides" aria-hidden="true"></div>
    <div class="conheca-scrim" aria-hidden="true"></div>

    <div class="conheca-inner">
        <header class="conheca-topo">
            <h2 class="conheca-heading">@Html.Raw(conhecaTitulo)</h2>
            @if (!string.IsNullOrWhiteSpace(conhecaDesc))
            {
                <p class="conheca-desc-intro">@Html.Raw(conhecaDesc)</p>
            }

            @if (Model.ConhecaEstancia.Count > 1 && temItens)
            {
                <div class="conheca-tabs" role="tablist" aria-label="Temas">
                    @foreach (var tab in Model.ConhecaEstancia)
                    {
                        <button type="button" class="conheca-tab" role="tab" data-tab="@tab.Chave">
                            <i data-lucide="@(tab.Icone ?? "star")" class="icon-lg"></i><span>@tab.Rotulo</span>
                        </button>
                    }
                </div>
            }
        </header>

        @if (temItens)
        {
            <div class="conheca-info" id="conhecaInfo" aria-live="polite">
                <span class="conheca-pill" id="conhecaPill"></span>
                <h3 class="conheca-name" id="conhecaName"></h3>
                <p class="conheca-des" id="conhecaDes"></p>
            </div>
        }
        else
        {
            <div class="conheca-empty">Em breve, novidades sobre Estância por aqui.</div>
        }
    </div>

    @if (temItens)
    {
        <button type="button" class="vitrine-seta vitrine-seta--overlay conheca-seta conheca-seta--prev" id="conhecaPrev" aria-label="Foto anterior">
            <i data-lucide="chevron-left" class="icon-lg"></i>
        </button>
        <button type="button" class="vitrine-seta vitrine-seta--overlay conheca-seta conheca-seta--next" id="conhecaNext" aria-label="Próxima foto">
            <i data-lucide="chevron-right" class="icon-lg"></i>
        </button>
        <div class="conheca-counter" id="conhecaCounter" aria-hidden="true"></div>
    }

    <script type="application/json" id="conhecaData">@Html.Raw(dadosJson)</script>
</section>
