@model HomeViewModel
@{
    var telefones = Model.Contatos.Where(c => c.Tipo == TurismoEstancia.Domain.Models.TipoContato.Telefone).ToList();
    var enderecos = Model.Contatos.Where(c => c.Tipo == TurismoEstancia.Domain.Models.TipoContato.Endereco).ToList();
    var redes = Model.Contatos.Where(c => c.Tipo == TurismoEstancia.Domain.Models.TipoContato.RedesSocial).ToList();
    var newsletterTitulo = Model.Conteudos.GetValueOrDefault("newsletter-titulo", "Receba a programação cultural, eventos e novidades direto no seu e-mail.");

    // 7 Maravilhas com pictograma cadastrado — a faixa decorativa do rodapé.
    // Regra de coleta compartilhada com o preloader (HomeViewModel.MaravilhasComPictograma).
    var maravilhasPicto = Model.MaravilhasComPictograma.ToList();
}

<footer class="site-footer" data-section="servicos">
    @if (maravilhasPicto.Count > 0)
    {
        <div class="footer-pictos">
            <div class="footer-pictos-inner">
                <p class="footer-pictos-eyebrow">
                    <span class="footer-eyebrow-line" aria-hidden="true"></span>
                    As 7 Maravilhas de Estância
                    <span class="footer-eyebrow-line" aria-hidden="true"></span>
                </p>
                <div class="footer-pictos-row">
                    @foreach (var maravilha in maravilhasPicto)
                    {
                        <a class="footer-picto" href="/lugares/@maravilha.Id" title="Ver detalhes: @maravilha.Nome">
                            <span class="footer-picto-tile">
                                <img src="/arquivo/@(maravilha.PictogramaArquivoId)" alt="" loading="lazy" />
                            </span>
                            <span class="footer-picto-nome">@maravilha.Nome</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="footer-inner">
        <div class="reveal reveal-delay-1">
            <div class="footer-brand">
                <img src="~/img/ASSINATURA-CAPITAL-MARAVILHAS-AZUL.png" alt="Logo Descubra Estância" style="height:36px;width:auto;" />
            </div>
            <div class="footer-org">
                <strong>Prefeitura Municipal de Estância</strong><br />
                Secretaria de Turismo, Cultura e Eventos
            </div>
            @if (enderecos.Count > 0)
            {
                <div class="footer-address">
                    @foreach (var end in enderecos)
                    {
                        @Html.Raw(end.Valor.Replace("\n", "<br />"))
                    }
                </div>
            }

            <div class="footer-pages">
                <div class="footer-pages-title">Navegue</div>
                <div class="footer-pages-grid">
                    <a href="/cidade">Nossa Cidade</a>
                    <a href="/cultura">Nossa Cultura</a>
                    <a href="/grupos-populares">Grupos Populares</a>
                    <a href="/gastronomia">Gastronomia</a>
                    <a href="/lugares">Lugares que Encantam</a>
                </div>
            </div>

            <!-- Social Media -->
            @if (redes.Count > 0)
            {
                <div class="footer-social">
                    @foreach (var rede in redes)
                    {
                        <a href="@rede.Valor" target="_blank" rel="noopener" class="footer-social-link" aria-label="@rede.Rotulo">
                            @switch (rede.Icone?.ToLowerInvariant())
                            {
                                case "instagram":
                                    <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                                        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                                    </svg>
                                    break;
                                case "facebook":
                                    <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                                    </svg>
                                    break;
                                case "youtube":
                                    <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
                                        <path d="m10 15 5-3-5-3z" />
                                    </svg>
                                    break;
                                default:
                                    <i data-lucide="@(string.IsNullOrWhiteSpace(rede.Icone) ? "globe" : rede.Icone)" class="icon-lg"></i>
                                    break;
                            }
                        </a>
                    }
                </div>
            }
        </div>

        <div class="reveal reveal-delay-2">
            <div class="footer-links-title"><i data-lucide="map-pin" class="icon-lg"></i> 7 Maravilhas no Mapa</div>
            <div class="footer-links-grid">
                @foreach (var ponto in Model.PontosParaMapa.Take(7))
                {
                    <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(ponto.Nome + " Estancia SE")" target="_blank" rel="noopener" class="footer-link">
                        <i data-lucide="@(ponto.Icone ?? "map-pin")"></i> @ponto.Nome
                    </a>
                }
            </div>
        </div>

        <div class="reveal reveal-delay-3">
            <div class="footer-contact-title"><i data-lucide="phone" class="icon-lg"></i> Serviços ao Turista</div>
            @if (telefones.Count == 0)
            {
                <div class="footer-contact-item"><i data-lucide="phone" class="icon-lg"></i> Emergência: <strong><a href="tel:190" style="color:inherit;text-decoration:none;">190</a></strong></div>
            }
            else
            {
                @foreach (var tel in telefones)
                {
                    var telLimpo = tel.Valor.Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
                    <div class="footer-contact-item">
                        <i data-lucide="@(tel.Icone ?? "phone")" class="icon-lg"></i> @tel.Rotulo:
                        <strong><a href="tel:@telLimpo" style="color:inherit;text-decoration:none;">@tel.Valor</a></strong>
                    </div>
                }
            }
        </div>

        <div class="reveal reveal-delay-4">
            <div class="footer-contact-title"><i data-lucide="mail" class="icon-lg"></i> Fique por dentro</div>
            <p>@newsletterTitulo</p>
            @if (TempData["NewsletterOk"] is string newsletterOk)
            {
                <div class="newsletter-feedback newsletter-feedback--ok" role="status">@newsletterOk</div>
            }
            @if (TempData["NewsletterErro"] is string newsletterErro)
            {
                <div class="newsletter-feedback newsletter-feedback--erro" role="alert">@newsletterErro</div>
            }
            <form class="newsletter-form" method="post" asp-controller="Newsletter" asp-action="Inscrever" id="newsletterForm">
                @Html.AntiForgeryToken()
                <div class="newsletter-input-wrapper">
                    <i data-lucide="mail" class="newsletter-input-icon icon-lg"></i>
                    <input type="email" name="email" class="newsletter-input" placeholder="Seu melhor e-mail" required autocomplete="email" aria-label="Email para newsletter" />
                </div>
                <label class="newsletter-lgpd">
                    <input type="checkbox" name="consentimentoLgpd" value="true" required />
                    <span>Aceito receber e-mails e concordo com a <strong>LGPD</strong>.</span>
                </label>
                <button type="submit" class="newsletter-btn">Quero receber <i data-lucide="send" class="icon-lg" aria-hidden="true"></i></button>
            </form>
            <a href="https://www.estancia.se.gov.br" target="_blank" rel="noopener" class="footer-back-link">← Voltar ao Portal de Serviços</a>
        </div>
    </div>

    <div style="max-width:1280px;margin:0 auto;">
        <div class="footer-bottom">
            <span class="footer-copyright">© @DateTime.Now.Year Prefeitura Municipal de Estância/SE — Todos os direitos reservados</span>
            <span class="footer-badge"><i data-lucide="globe" class="icon-lg"></i> Portal Oficial de Turismo</span>
        </div>
    </div>
</footer>
