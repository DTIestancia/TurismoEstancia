@model HomeViewModel
@{
    var gastroDesc = Model.Conteudos.GetValueOrDefault("gastronomia-descricao",
        "A alma de Estância vive nas batucadas, nos tambores e na mesa farta dos seus restaurantes — receitas que <em>atravessam gerações</em>.");
    var gastroMain = Model.Conteudos.GetValueOrDefault("gastronomia-main-texto",
        "Moqueca de peixe, arroz de polvo, caldeirada de camarão, tapioca recheada e a inesquecível cocada puxa.");
    var gastroGruposTexto = Model.Conteudos.GetValueOrDefault("gastronomia-grupos-texto",
        "Reisados, cacumbis, samba de coco e batucadas que mantêm vivas as raízes afro-brasileiras e nordestinas da cidade.");
}

<section class="section-gastronomy section-3d section-divider" id="section-gastronomia" data-section="gastronomia">
    <div class="bg-deco" style="width:320px;height:320px;left:-80px;top:-80px;opacity:0.90;overflow:hidden;">
        <div style="width:219.17px;height:195.60px;margin:67px auto 0;background:var(--color-orange-57);border-radius:4px;transform:rotate(45deg);"></div>
    </div>
    <div class="bg-deco" style="width:380px;height:380px;right:-60px;bottom:100px;opacity:0.80;overflow:hidden;">
        <div style="width:261.38px;height:261.46px;margin:56px auto 0;background:var(--color-orange-51);border-radius:4px;transform:rotate(45deg);"></div>
    </div>
    <div class="bg-dot" style="width:8px;height:8px;right:30%;top:297px;background:#FFDC62;border-radius:9999px;"></div>

    <div class="section-gastronomy-inner">
        <div class="gastronomy-header reveal">
            <div class="gastronomy-cursive">na mesa &amp; na rua</div>
            <div class="gastronomy-title-wrap">
                <div class="gastronomy-title-line serif-italic">Grupos</div>
                <div class="gastronomy-title-line georgia-bold">populares</div>
                <div class="gastronomy-title-ampersand">&amp;</div>
                <div class="gastronomy-title-line georgia-bold white">gastronomia.</div>
            </div>
            <div class="gastronomy-desc reveal reveal-delay-1">
                <p>@Html.Raw(gastroDesc)</p>
                <div class="gastronomy-desc-actions">
                    <a href="/gastronomia" class="btn-primary">Ver gastronomia <i data-lucide="arrow-right" class="icon-lg"></i></a>
                    <a href="/grupos-populares" class="btn-secondary"><i data-lucide="users" class="icon-lg"></i> Grupos populares</a>
                </div>
            </div>
        </div>

        <div class="gastronomy-layout reveal reveal-delay-2">
            <!-- Main Card -->
            <div class="gastronomy-card-main">
                <div class="gastronomy-card">
                    <div class="gastronomy-card-img-wrap">
                        @if (Model.Slides.Count > 0)
                        {
                            // Usa o último slide disponível como imagem de fundo da gastronomia.
                            var slideGastro = Model.Slides[Math.Min(3, Model.Slides.Count - 1)];
                            <img src="/arquivo/@(slideGastro.ImagemArquivoId is long gId ? gId.ToString() : "")" alt="Sabores do litoral sergipano" loading="lazy" />
                        }
                        <div class="gastronomy-card-overlay"></div>
                        <div class="gastronomy-card-content">
                            <div class="gastronomy-card-pill">Sabores do Litoral</div>
                            <div class="gastronomy-card-title-main">
                                Sabores <span class="light">do</span><br />
                                litoral sergipano
                            </div>
                            <div class="gastronomy-card-text">
                                @gastroMain
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side Cards -->
            <div class="gastronomy-side">
                <div class="gastronomy-side-card gastronomy-side-card--red reveal-left">
                    <div class="gastronomy-side-header">
                        <div class="gastronomy-side-icon gastronomy-side-icon--red">
                            <i data-lucide="users" class="icon-xl"></i>
                        </div>
                        <div class="gastronomy-side-title">Grupos</div>
                    </div>
                    <div class="gastronomy-side-text">
                        @gastroGruposTexto
                    </div>
                    <div class="gastronomy-tags">
                        @if (Model.GruposCulturais.Count == 0)
                        {
                            <span class="gastronomy-tag">Reisado</span>
                            <span class="gastronomy-tag">Cacumbi</span>
                            <span class="gastronomy-tag">Batucada</span>
                            <span class="gastronomy-tag">Samba de Coco</span>
                        }
                        else
                        {
                            @foreach (var grupo in Model.GruposCulturais)
                            {
                                <span class="gastronomy-tag">@grupo.Nome</span>
                            }
                        }
                    </div>
                </div>

                <div class="gastronomy-side-card gastronomy-side-card--light reveal-right">
                    <div class="gastronomy-side-header">
                        <div class="gastronomy-side-icon gastronomy-side-icon--orange">
                            <i data-lucide="utensils" class="icon-xl"></i>
                        </div>
                        <div class="gastronomy-side-title">Pratos <span class="light">imperdíveis</span></div>
                    </div>
                    <div class="gastronomy-dish-list">
                        @if (Model.PratosTuristicos.Count == 0)
                        {
                            <div class="gastronomy-dish-item"><span class="bullet">▸</span> Moqueca de peixe na panela de barro</div>
                            <div class="gastronomy-dish-item"><span class="bullet">▸</span> Camarão na moranga</div>
                            <div class="gastronomy-dish-item"><span class="bullet">▸</span> Tapioca recheada com queijo coalho</div>
                            <div class="gastronomy-dish-item"><span class="bullet">▸</span> Cocada puxa e bolo de macaxeira</div>
                        }
                        else
                        {
                            @foreach (var prato in Model.PratosTuristicos)
                            {
                                <div class="gastronomy-dish-item"><span class="bullet">▸</span> @prato.Nome</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
