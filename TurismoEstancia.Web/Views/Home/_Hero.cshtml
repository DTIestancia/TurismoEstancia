@model HomeViewModel
@using TurismoEstancia.Domain.Models
@{
    // Título do hero editável pelo painel (Hero → "Título"). Fonte vazada
    // (esboçada) sobre o vídeo, como no print: uma só palavra em destaque.
    var heroTitulo = Model.Conteudos.GetValueOrDefault("hero-titulo", "ESTÂNCIA");
    var heroSubtitulo = Model.Conteudos.GetValueOrDefault("hero-subtitulo",
        "Explore as Cores, a História e a Tradição de Estância") ?? "";
    var slides = Model.Slides.Any() ? Model.Slides : null;

    // Pictogramas das 7 maravilhas para o preloader personalizado.
    // Regra de coleta compartilhada com o rodapé (HomeViewModel.MaravilhasComPictograma).
    var pictogramas = Model.MaravilhasComPictograma
        .Select(p => p.PictogramaArquivoId!.Value)
        .Distinct()
        .ToList();

    // Redes sociais exibidas na navbar — mesma fonte do rodapé (Contatos).
    var redesSociais = Model.Contatos.Where(c => c.Tipo == TipoContato.RedesSocial).ToList();
}

<!-- ===== Reading Progress Bar ===== -->
<div class="progress-bar" id="progressBar" aria-hidden="true"></div>

<!-- ===== Page Preloader ===== -->
<div id="pageLoader" class="page-loader" aria-hidden="true">
    <div class="page-loader-content">
        <div class="loader-picto-row">
            @for (var i = 0; i < pictogramas.Count; i++)
            {
                <img src="@Url.Content($"~/arquivo/{pictogramas[i]}")" alt="" class="loader-picto" aria-hidden="true" />
            }
        </div>
        <div class="page-loader-bar-track">
            <div class="page-loader-bar-fill"></div>
        </div>
        <p class="page-loader-text">Carregando ...</p>
    </div>
</div>
<noscript><style>.page-loader { display: none !important; }</style></noscript>

<!-- ===== Navbar ===== -->
<nav class="navbar" id="navbar">
    <div class="navbar-inner">
        <a href="#section-cidade" class="navbar-brand">
            @await Component.InvokeAsync("LogoSite", new { altura = 36 })
        </a>
        <button class="navbar-toggle" id="navToggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="navLinks">
            <span class="navbar-toggle-icon" aria-hidden="true"></span>
        </button>
        <div class="navbar-links" id="navLinks">
            <a href="#section-historia" class="navbar-link" data-section="cidade">Nossa Cidade</a>
            <a href="#section-conheca" class="navbar-link" data-section="conheca">Conheça Estância</a>
            <a href="#section-maravilhas" class="navbar-link" data-section="maravilhas">7 Maravilhas</a>
            <a href="#section-noticias" class="navbar-link" data-section="noticias">Notícias</a>
            <a href="~/galeria" class="navbar-link">Galeria</a>
            <a href="~/Agenda" class="navbar-link">Agenda</a>
            <a href="#section-servicos" class="navbar-link" data-section="servicos">Serviços ao Turista</a>

            @if (redesSociais.Count > 0)
            {
                <div class="navbar-social" aria-label="Redes sociais">
                    @foreach (var rede in redesSociais)
                    {
                        <a href="@rede.Valor" target="_blank" rel="noopener" class="navbar-social-link" aria-label="@rede.Rotulo" title="@rede.Rotulo">
                            @await Html.PartialAsync("_IconeRedeSocial", rede)
                        </a>
                    }
                </div>
            }

            <label class="navbar-lang" title="Idioma do site">
                <i data-lucide="globe" class="icon-lg"></i>
                <select id="siteLang" class="navbar-lang-select" aria-label="Idioma do site">
                    <option value="pt-BR">PT</option>
                    <option value="en">EN</option>
                    <option value="es">ES</option>
                </select>
            </label>

            <button class="theme-toggle" id="themeToggle" aria-label="Alternar tema claro/escuro" title="Alternar tema">
                <i data-lucide="moon" class="icon-lg" id="themeToggleIcon"></i>
            </button>
            @if (Model.GuiaDisponivel)
            {
                <a asp-controller="Arquivo" asp-action="Index" asp-route-id="@Model.Guia!.ArquivoId" class="navbar-cta-mobile">
                    <i data-lucide="download" class="icon-lg"></i> Baixe o Guia
                </a>
            }
        </div>
        @if (Model.GuiaDisponivel)
        {
            <a asp-controller="Arquivo" asp-action="Index" asp-route-id="@Model.Guia!.ArquivoId" class="navbar-cta">
                <i data-lucide="download" class="icon-lg"></i> Baixe o Guia
            </a>
        }
    </div>
</nav>

<!-- ===== Hero Section ===== -->
<section class="hero section-blend" id="section-cidade" data-section="cidade">
    @if (Model.VideoArquivoId is long videoId)
    {
        var poster = Model.VideoPosterArquivoId is long posterId ? Url.Content($"~/arquivo/{posterId}") : null;
        <video class="hero-bg" id="heroBgVideo" autoplay muted loop playsinline webkit-playsinline poster="@poster">
            <source src="@Url.Content($"~/arquivo/{videoId}")" type="video/mp4" />
            Seu navegador não suporta vídeo HTML5.
        </video>
    }
    else if (slides is not null)
    {
        long imgId = 0;
        var tituloCapa = "Estância";
        foreach (var s in slides)
        {
            if (s.ImagemArquivoId is long id)
            {
                imgId = id;
                tituloCapa = s.Titulo ?? "Estância";
                break;
            }
        }
        @if (imgId > 0)
        {
            <img class="hero-bg" src="@Url.Content($"~/arquivo/{imgId}")" alt="@tituloCapa" />
        }
    }
    <div class="hero-overlay"></div>
    <div class="hero-vignette"></div>
    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title hero-title-outline">@Html.Raw(heroTitulo)</h1>
            <p class="hero-subtitle">@Html.Raw(heroSubtitulo.Replace("\n", "<br />"))</p>
        </div>
    </div>
    <div class="hero-scroll-indicator">
        <span>Role para explorar</span>
        <i data-lucide="chevron-down" class="icon-lg"></i>
    </div>
</section>
