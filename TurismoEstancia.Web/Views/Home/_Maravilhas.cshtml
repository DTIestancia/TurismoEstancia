@model HomeViewModel
@{
    var maravilhasTitulo = Model.Conteudos.GetValueOrDefault("maravilhas-titulo",
        "Lugares que <span class=\"vitrine-accent\">encantam</span>") ?? "";
    var maravilhasDesc = Model.Conteudos.GetValueOrDefault("maravilhas-descricao",
        "De filarmônicas centenárias a praias de tirar o fôlego — cada cantinho de Estância tem uma história esperando por você.") ?? "";
    var maravilhas = Model.CategoriasMaravilhas
        .SelectMany(g => g.Pontos)
        .OrderBy(p => p.Ordem)
        .ToList();
}

<section class="section-wonders section-divider" id="section-maravilhas" data-section="maravilhas">
    <div class="section-wonders-inner">
        <div class="vitrine-eyebrow reveal">
            <span class="vitrine-eyebrow-star">✦</span>
            <span>Lugares quem encantam</span>
        </div>
        <h2 class="section-title reveal">
            @Html.Raw(maravilhasTitulo)
        </h2>
        <p class="section-desc reveal reveal-delay-1 vitrine-section-desc">
            @Html.Raw(maravilhasDesc.Replace("\n", "<br />"))
        </p>

        <div class="vitrine-wrap reveal reveal-delay-1">
            @await Html.PartialAsync("_VitrineMaravilhas", maravilhas)
        </div>

        <div class="vitrine-link reveal reveal-delay-2">
            <a href="@Url.Content("~/lugares")" class="btn-primary">
                Ver todas as maravilhas <i data-lucide="arrow-right" class="icon-lg"></i>
            </a>
        </div>
    </div>
</section>
