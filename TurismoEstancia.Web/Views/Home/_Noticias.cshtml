@model HomeViewModel
@{
    var noticiasDesc = Model.Conteudos.GetValueOrDefault("noticias-descricao",
        "Cultura, eventos e novidades da Capital Sergipana da Cultura.");
    // Pictogramas das 7 maravilhas — viram os "destaques" estilo stories do Instagram.
    var maravilhasPicto = Model.MaravilhasComPictograma.ToList();
}

@if (Model.Noticias.Count > 0)
{
    <section class="section-noticias section-divider section-instagram" id="section-noticias">
        <div class="section-noticias-inner">
            <div class="section-tag">
                <div class="pill pill-white">
                    <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-white-solid);" aria-hidden="true">
                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                    </svg>
                    <span style="color:var(--color-white-solid);font-size:12px;font-weight:700;line-height:16px;">Fique por dentro</span>
                </div>
            </div>

            <!-- Cabeçalho estilo perfil do Instagram (referência: @@vempraestancia) -->
            <div class="ig-profile reveal">
                <div class="ig-avatar-ring" aria-hidden="true">
                    <div class="ig-avatar-inner">
                        @await Component.InvokeAsync("LogoSite", new { altura = 46, alt = "Vem pra Estância" })
                    </div>
                </div>
                <div class="ig-profile-info">
                    <div class="ig-handle-row">
                        <h2 class="ig-handle">@@vempraestancia</h2>
                        <a class="ig-follow" href="https://www.instagram.com/vempraestancia" target="_blank" rel="noopener"
                           title="Abrir o perfil oficial de turismo no Instagram" data-track="instagram-seguir">Seguir</a>
                    </div>
                    <p class="ig-name">Vem pra Estância · Turismo oficial</p>
                    <p class="ig-bio">@noticiasDesc</p>
                </div>
            </div>

            <!-- Destaques estilo stories: os 7 pictogramas das maravilhas -->
            @if (maravilhasPicto.Count > 0)
            {
                <div class="ig-highlights reveal reveal-delay-1">
                    @foreach (var m in maravilhasPicto)
                    {
                        <a class="ig-highlight" href="@Url.Content($"~/lugares/{m.Id}")" title="Ver detalhes: @m.Nome">
                            <span class="ig-highlight-ring">
                                <img src="@Url.Content($"~/arquivo/{m.PictogramaArquivoId}")" alt="" loading="lazy" />
                            </span>
                            <span class="ig-highlight-nome">@m.Nome</span>
                        </a>
                    }
                </div>
            }

            <!-- Feed estilo Instagram: as 3 últimas notícias em grade quadrada,
                 com a foto em cima e o texto (data + título) sempre exposto -->
            <div class="ig-feed reveal reveal-delay-1">
                @foreach (var noticia in Model.Noticias)
                {
                    <a class="ig-post" href="~/Noticias/Detalhe/@noticia.Slug"
                       data-track="noticia" data-track-id="@noticia.Id" data-track-nome="@noticia.Titulo">
                        <span class="ig-post-foto">
                            @if (noticia.ImagemArquivoId is long imgId)
                            {
                                <img class="ig-post-img" src="@Url.Content($"~/arquivo/{imgId}")" alt="@noticia.Titulo" loading="lazy" />
                            }
                            else
                            {
                                <span class="ig-post-fallback" aria-hidden="true"><i data-lucide="newspaper" class="icon-xl"></i></span>
                            }
                            <span class="ig-post-ver">Ver notícia <i data-lucide="arrow-right" class="icon-lg"></i></span>
                        </span>
                        <span class="ig-post-texto">
                            <span class="ig-post-date">@noticia.DataPublicacao.ToString("dd 'de' MMMM", new System.Globalization.CultureInfo("pt-BR"))</span>
                            <span class="ig-post-title">@noticia.Titulo</span>
                        </span>
                    </a>
                }
            </div>

            <div class="section-noticias-link reveal reveal-delay-2">
                <a href="~/Noticias" class="btn-primary">Ver todas as notícias <i data-lucide="arrow-right" class="icon-lg"></i></a>
                <a href="https://www.instagram.com/vempraestancia" target="_blank" rel="noopener" class="btn-secondary">
                    <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                    </svg>
                    Siga @@vempraestancia
                </a>
            </div>
        </div>
    </section>
}
