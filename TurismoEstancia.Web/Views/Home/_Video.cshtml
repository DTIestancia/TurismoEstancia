@model HomeViewModel
<section class="section-video section-divider" id="institutionalVideo" data-section="cidade">
    <div class="video-full" id="videoFull">
        @if (Model.VideoArquivoId is long videoId)
        {
            @* muted + loop + playsinline: autoplay permitido por todos os navegadores
               (inclusive Safari iOS) — o vídeo toca sozinho ao passar pela seção. *@
            <video preload="metadata" muted loop playsinline webkit-playsinline id="heroVideo">
                <source src="@Url.Content($"~/arquivo/{videoId}")" type="video/mp4" />
                Seu navegador não suporta vídeo HTML5.
            </video>
            @* Botão de som: o autoplay começa mudo; um toque ativa/desativa o áudio. *@
            <button type="button" id="videoMuteBtn" class="video-mute-btn" aria-label="Ativar som do vídeo" aria-pressed="false">
                <i data-lucide="volume-x" class="icon-lg"></i>
            </button>
            @* Fallback para iPhone/iPad: se o Safari não conseguir reproduzir inline
               (codec/estado stalled/Low Data Mode), oferece abrir no player nativo
               em nova aba — o MP4 (H.264) roda direto no Safari. *@
            <a href="@Url.Content($"~/arquivo/{videoId}")" target="_blank" rel="noopener"
               id="videoFallbackLink" class="video-fallback-link" style="display:none;">
                <i data-lucide="external-link" class="icon-lg"></i>
                <span>Não reproduziu? Abrir vídeo em nova aba</span>
            </a>
        }
        else
        {
            <video preload="metadata" muted loop playsinline webkit-playsinline id="heroVideo">
                Seu navegador não suporta vídeo HTML5.
            </video>
        }
        <div class="video-full-gradient"></div>

        <!-- Cinematic Play Button -->
        <div class="video-play-cinema reveal reveal-delay-1" id="cinemaPlayBtn">
            <div class="video-play-btn">
                <div class="video-play-ring"></div>
                <div class="video-play-ring"></div>
                <div class="video-play-core">
                    <div class="video-play-triangle"></div>
                </div>
                <span class="video-play-label">Assistir</span>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="video-scroll-indicator reveal reveal-delay-2">
            <span>Role para explorar</span>
            <i data-lucide="chevron-down" class="icon-lg"></i>
        </div>
    </div>
</section>
