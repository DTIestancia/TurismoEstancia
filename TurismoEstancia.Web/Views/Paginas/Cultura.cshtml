@model SecaoConhecaViewModel
@{
    ViewData["Title"] = "Conheça Estância";
    var conhecaTitulo = Model.Conteudos.GetValueOrDefault("conheca-titulo",
        "Conheça <strong>Estância</strong>") ?? "";
    var conhecaDescricao = Model.Conteudos.GetValueOrDefault("conheca-descricao",
        "História, cultura, gastronomia e experiências — escolha um tema e explore cada cantinho da cidade.") ?? "";
    var capaHero = CapaHero.Montar(Model.Conteudos, "cultura-capa", id => Url.Content($"~/arquivo/{id}?largura=1920"));
}
<main class="paginas-page page-public paginas-page--cultura">
    @await Html.PartialAsync("_PaginasHeader")

    <section class="paginas-hero@(capaHero.Tem ? " paginas-hero--capa" : "")">
        @if (capaHero.Tem)
        {
            <img class="paginas-hero-capa-img" src="@capaHero.Url" style="@capaHero.Estilo" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
            <div class="paginas-hero-overlay" aria-hidden="true"></div>
        }
        <div class="paginas-hero-inner">
            <div class="pill pill--light">
                <i data-lucide="compass" class="icon-lg"></i>
                <span>História, cultura, gastronomia e experiências</span>
            </div>
            <h1 class="paginas-hero-title">@Html.Raw(conhecaTitulo)</h1>
            <p class="paginas-hero-subtitle">@Html.Raw(conhecaDescricao)</p>
        </div>
    </section>

    <div class="paginas-container">
        @foreach (var aba in Model.Abas)
        {
            <section class="paginas-conheca-aba" id="conheca-@(aba.Chave)">
                <div class="section-tag" style="text-align:left;">
                    <div class="pill pill--light">
                        <i data-lucide="@(aba.Icone ?? "star")" class="icon-lg"></i>
                        <span>@aba.Rotulo</span>
                    </div>
                </div>
                <div class="paginas-grid">
                    @if (aba.Itens.Count == 0)
                    {
                        <div class="news-empty">Em breve, novidades sobre @aba.Rotulo.ToLower().</div>
                    }
                    else
                    {
                        @foreach (var item in aba.Itens)
                        {
                            <a class="paginas-card" href="@Url.Content(item.Url ?? $"~/conheca-estancia/{item.Id}")">
                                @if (item.ImagemArquivoId is long img)
                                {
                                    <img class="paginas-card-img" src="@Url.Content($"~/arquivo/{img}?largura=800")" alt="@item.Nome" loading="lazy" decoding="async" />
                                }
                                <div class="paginas-card-body">
                                    <h3 class="paginas-card-title">@item.Nome</h3>
                                    @if (!string.IsNullOrWhiteSpace(item.Descricao))
                                    {
                                        <p class="paginas-card-desc">@item.Descricao</p>
                                    }
                                    <span class="btn-primary paginas-card-btn">
                                        Ver mais <i data-lucide="arrow-right" class="icon-lg"></i>
                                    </span>
                                </div>
                            </a>
                        }
                    }
                </div>
            </section>
        }

        @await Html.PartialAsync("_JornadaNavegacao", new JornadaNavModel
        {
            AnteriorRotulo = "Nossa Cidade",
            AnteriorUrl = "~/cidade",
            ProximoRotulo = "7 Maravilhas",
            ProximoUrl = "~/lugares"
        })
    </div>

    @await Html.PartialAsync("_PaginasFooter")
</main>
