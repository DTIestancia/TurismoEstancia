@model SecaoLugaresViewModel
@{
    ViewData["Title"] = "Lugares que Encantam";
    var maravilhasDesc = Model.Conteudos.GetValueOrDefault("maravilhas-descricao",
        "De filarmônicas centenárias a praias de tirar o fôlego — cada cantinho de Estância tem uma história esperando por você.");
}
<main class="paginas-page page-public paginas-page--lugares">
    @await Html.PartialAsync("_PaginasHeader")

    <section class="paginas-hero">
        <div class="paginas-hero-inner">
            <div class="pill pill-white" style="background:var(--color-white--15);">
                <span style="font-size:12px;">✦</span>
                <span style="color:var(--color-white-solid);font-size:12px;font-weight:700;">7 Maravilhas de Estância</span>
            </div>
            <h1 class="paginas-hero-title">Lugares que <span class="secao-destaque">Encantam</span></h1>
            <p class="paginas-hero-subtitle">@Html.Raw(maravilhasDesc.Replace("\n", "<br />"))</p>
        </div>
    </section>

    <div class="paginas-container paginas-container--vitrine">
        @if (Model.Maravilhas.Count == 0)
        {
            <div class="news-empty">Nenhuma maravilha cadastrada ainda.</div>
        }
        else
        {
            <div class="paginas-grid">
                @for (var i = 0; i < Model.Maravilhas.Count; i++)
                {
                    var ponto = Model.Maravilhas[i];
                    var cor = ponto.CategoriaCor ?? "#F97E31";
                    <a class="paginas-card paginas-card--maravilha" href="@Url.Content($"~/lugares/{ponto.Id}/{Slug.De(ponto.Nome)}")"
                       data-track="ver-maravilha" data-track-id="@ponto.Id" data-track-nome="@ponto.Nome">
                        <figure class="paginas-card-figure">
                            @if (ponto.CapaArquivoId is long capa)
                            {
                                <img class="paginas-card-img" src="@Url.Content($"~/arquivo/{capa}")" alt="@ponto.Nome" loading="lazy" />
                            }
                            else
                            {
                                <img class="paginas-card-img" src="" alt="@ponto.Nome" loading="lazy" />
                            }
                            <span class="paginas-card-num">@((i + 1).ToString("00"))</span>
                        </figure>
                        <div class="paginas-card-body">
                            @if (!string.IsNullOrWhiteSpace(ponto.CategoriaNome))
                            {
                                <span class="paginas-card-cat" style="color:color-mix(in srgb, @cor 70%, #fff);border-color:@cor;background:@(cor + "26");">@ponto.CategoriaNome</span>
                            }
                            <h3 class="paginas-card-title">@ponto.Nome</h3>
                            @if (!string.IsNullOrWhiteSpace(ponto.Descricao))
                            {
                                <p class="paginas-card-desc">@ponto.Descricao</p>
                            }
                            <span class="btn-primary paginas-card-btn">
                                Ver detalhes <i data-lucide="arrow-right" class="icon-lg"></i>
                            </span>
                        </div>
                    </a>
                }
            </div>
        }

        <div class="paginas-cta-row paginas-cta-row--center">
            <a href="@Url.Content("~/")" class="btn-secondary"><i data-lucide="map" class="icon-lg"></i> Ver tudo no mapa da home</a>
        </div>
    </div>

    @await Html.PartialAsync("_PaginasFooter")
</main>
