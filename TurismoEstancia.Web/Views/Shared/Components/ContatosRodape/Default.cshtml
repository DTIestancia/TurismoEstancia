@model TurismoEstancia.Web.Components.ContatosRodapeViewComponent.ContatosRodapeModel
@using TurismoEstancia.Domain.Models
@{
    var enderecos = Model.Contatos.Where(c => c.Tipo == TipoContato.Endereco).ToList();
    var telefones = Model.Contatos.Where(c => c.Tipo == TipoContato.Telefone).ToList();
    var redes = Model.Contatos.Where(c => c.Tipo == TipoContato.RedesSocial)
        .GroupBy(c => { var v=(c.Valor??"").ToLowerInvariant(); if(v.Contains("instagram")) return "instagram"; if(v.Contains("facebook")) return "facebook"; if(v.Contains("tiktok")) return "tiktok"; if(v.Contains("youtube")||v.Contains("youtu.be")) return "youtube"; if(v.Contains("wa.me")||v.Contains("whatsapp")) return "whatsapp"; if(v.Contains("twitter")||v.Contains("x.com")) return "x"; if(v.Contains("linkedin")) return "linkedin"; return v.Trim().TrimEnd('/'); })
        .Select(g => g.First()).ToList();
    var emails = Model.Contatos.Where(c => c.Tipo == TipoContato.Email).ToList();
    var mostraEnderecos = Model.Bloco is "todos" or "enderecos";
    var mostraTelefones = Model.Bloco is "todos" or "telefones";
    var mostraRedes = Model.Bloco is "todos" or "redes";
}

@if (mostraEnderecos && enderecos.Count > 0)
{
    <div class="footer-address">
        @foreach (var end in enderecos)
        {
            <div class="footer-contact-item">
                <i data-lucide="map-pin" class="icon-lg" aria-hidden="true"></i>
                @if (!string.IsNullOrWhiteSpace(end.Rotulo))
                {
                    <strong>@(end.Rotulo):</strong>
                }
                <span>@Html.Raw(end.Valor.Replace("\n", "<br />"))</span>
            </div>
        }
    </div>
}

@if (mostraEnderecos && emails.Count > 0)
{
    <div class="footer-address">
        @foreach (var email in emails)
        {
            var mailto = email.Valor.Trim();
            <div class="footer-contact-item">
                <i data-lucide="mail" class="icon-lg" aria-hidden="true"></i>
                @if (!string.IsNullOrWhiteSpace(email.Rotulo))
                {
                    <strong>@(email.Rotulo):</strong>
                }
                <span><a href="mailto:@mailto" style="color:inherit;text-decoration:none;">@email.Valor</a></span>
            </div>
        }
    </div>
}

@if (mostraTelefones && telefones.Count > 0)
{
    @foreach (var tel in telefones)
    {
        var telLimpo = tel.Valor.Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
        var ehWhats = tel.Icone?.Equals("whatsapp", StringComparison.OrdinalIgnoreCase) == true
            || tel.Valor.Contains("wa.me", StringComparison.OrdinalIgnoreCase)
            || tel.Valor.Contains("whatsapp", StringComparison.OrdinalIgnoreCase);
        var linkWhats = ehWhats
            ? "https://wa.me/" + new string(tel.Valor.Where(char.IsDigit).ToArray())
            : null;
        <div class="footer-contact-item">
            @if (ehWhats)
            {
                <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
                <span>@tel.Rotulo:</span>
                <strong><a href="@linkWhats" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">@tel.Valor</a></strong>
            }
            else
            {
                <i data-lucide="@(tel.Icone ?? "phone")" class="icon-lg"></i> <span>@tel.Rotulo:</span>
                <strong><a href="tel:@telLimpo" style="color:inherit;text-decoration:none;">@tel.Valor</a></strong>
            }
        </div>
    }
}

@if (mostraRedes && redes.Count > 0)
{
    <div class="footer-social">
        @foreach (var rede in redes)
        {
            <a href="@rede.Valor" target="_blank" rel="noopener" class="footer-social-link" aria-label="@rede.Rotulo" title="@rede.Rotulo">
                @{
                    var iconeRede = (rede.Icone ?? string.Empty).ToLowerInvariant();
                    if (string.IsNullOrWhiteSpace(iconeRede))
                    {
                        if (rede.Valor.Contains("instagram", StringComparison.OrdinalIgnoreCase)) { iconeRede = "instagram"; }
                        else if (rede.Valor.Contains("facebook", StringComparison.OrdinalIgnoreCase)) { iconeRede = "facebook"; }
                        else if (rede.Valor.Contains("youtube", StringComparison.OrdinalIgnoreCase) || rede.Valor.Contains("youtu.be", StringComparison.OrdinalIgnoreCase)) { iconeRede = "youtube"; }
                        else if (rede.Valor.Contains("wa.me", StringComparison.OrdinalIgnoreCase) || rede.Valor.Contains("whatsapp", StringComparison.OrdinalIgnoreCase)) { iconeRede = "whatsapp"; }
                        else if (rede.Valor.Contains("tiktok", StringComparison.OrdinalIgnoreCase)) { iconeRede = "tiktok"; }
                        else if (rede.Valor.Contains("x.com", StringComparison.OrdinalIgnoreCase) || rede.Valor.Contains("twitter", StringComparison.OrdinalIgnoreCase)) { iconeRede = "x"; }
                        else if (rede.Valor.Contains("linkedin", StringComparison.OrdinalIgnoreCase)) { iconeRede = "linkedin"; }
                    }
                }
                @switch (iconeRede)
                {
                    case "instagram":
                        <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                        </svg>
                        break;
                    case "facebook":
                        <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                        </svg>
                        break;
                    case "youtube":
                        <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
                            <path d="m10 15 5-3-5-3z" />
                        </svg>
                        break;
                    case "whatsapp":
                    case "message-circle":
                    case "message-circle-more":
                        <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                        </svg>
                        break;
                    case "tiktok":
                        <svg class="icon-lg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
                        </svg>
                        break;
                    case "x":
                    case "twitter":
                        <svg class="icon-lg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" />
                        </svg>
                        break;
                    case "linkedin":
                        <svg class="icon-lg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" />
                        </svg>
                        break;
                    default:
                        <i data-lucide="@(string.IsNullOrWhiteSpace(rede.Icone) ? "globe" : rede.Icone)" class="icon-lg"></i>
                        break;
                }
            </a>
        }
    </div>
}
