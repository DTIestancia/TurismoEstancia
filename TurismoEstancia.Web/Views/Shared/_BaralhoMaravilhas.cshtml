@model IReadOnlyList<PontoTuristicoDto>
@if (Model.Count == 0)
{
    <div class="deck-empty">Em breve, as maravilhas de Estância estarão aqui.</div>
}
else
{
    <div class="wonders-deck" id="wondersDeck" data-total="@Model.Count">
        <div class="wonders-deck-stage" aria-label="Baralho de maravilhas">
            @for (var i = 0; i < Model.Count; i++)
            {
                var ponto = Model[i];
                <article class="wonder-deck-card@(i == 0 ? " is-active" : "")" data-index="@i" style="z-index:@(Model.Count - i);">
                    @if (ponto.CapaArquivoId is long capa)
                    {
                        <img class="wonder-deck-img" src="/arquivo/@capa" alt="@ponto.Nome" loading="lazy" />
                    }
                    <div class="wonder-deck-overlay"></div>
                    <span class="wonder-deck-number">@(i + 1)</span>
                    <div class="wonder-deck-body">
                        @if (ponto.PictogramaArquivoId is long picto)
                        {
                            <img src="/arquivo/@picto" alt="" class="wonder-deck-picto" loading="lazy" />
                        }
                        <div class="wonder-deck-category">@ponto.CategoriaNome</div>
                        <h3 class="wonder-deck-title">@ponto.Nome</h3>
                        <p class="wonder-deck-desc">@ponto.Descricao</p>
                        @if (!string.IsNullOrWhiteSpace(ponto.Tag))
                        {
                            <span class="wonder-tag">@ponto.Tag</span>
                        }
                        <a class="btn-primary wonder-deck-btn" href="/lugares/@ponto.Id/@Slug.De(ponto.Nome)">
                            Ver detalhes <i data-lucide="arrow-right" class="icon-lg"></i>
                        </a>
                    </div>
                </article>
            }
        </div>
        <div class="wonders-deck-controls">
            <button type="button" class="wonders-deck-arrow" id="deckPrev" aria-label="Carta anterior"><i data-lucide="chevron-left" class="icon-lg"></i></button>
            <span class="wonders-deck-counter" id="deckCounter">1 / @Model.Count</span>
            <button type="button" class="wonders-deck-arrow" id="deckNext" aria-label="Próxima carta"><i data-lucide="chevron-right" class="icon-lg"></i></button>
        </div>
        <p class="wonders-deck-hint"><i data-lucide="mouse-pointer-click" class="icon-lg"></i> Passe as cartas para conhecer as maravilhas de Estância</p>
    </div>
}
