@using TurismoEstancia.Services.Conteudo.Interfaces
@inject SeoService SeoService
@inject IConfiguracaoSiteService Configuracoes
@{
    // Favicon exclusivo (configuração "favicon", tipo Arquivo): quando existe um
    // PNG enviado, o <link rel="icon"> aponta direto para ele; sem ele, usa o
    // /favicon.svg estático (o middleware redireciona para a logo, se houver).
    var faviconConfig = await Configuracoes.ObterPorChaveAsync("favicon", Context.RequestAborted);
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ED2027" />
    <link rel="manifest" href="@Url.Content("~/manifest.webmanifest")" />
    @if (faviconConfig?.ArquivoId is long faviconId)
    {
        <link rel="icon" type="image/png" href="@Url.Content($"~/arquivo/{faviconId}")" />
        <link rel="apple-touch-icon" href="@Url.Content("~/apple-touch-icon.png")" />
    }
    else
    {
        <link rel="icon" type="image/svg+xml" href="@Url.Content("~/favicon.svg")" />
    }
    <script>
        // A página abre sempre no topo: o navegador (sobretudo no celular) tende a
        // restaurar a rolagem da visita anterior e "pular" para o meio da página.
        // Se o link veio com âncora (#section-...), rola até ela após carregar.
        (function () {
            try { if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; } catch (e) { }
            if (location.hash && location.hash.length > 1) {
                window.addEventListener('load', function () {
                    var alvo = document.getElementById(location.hash.slice(1));
                    if (alvo) setTimeout(function () { alvo.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 600);
                });
            } else {
                window.scrollTo(0, 0);
            }
            // Navegação Voltar/Avançar (bfcache) também restaura a rolagem antiga —
            // volta ao topo quando a página vem do cache da sessão.
            window.addEventListener('pageshow', function (e) {
                if (e.persisted) {
                    window.scrollTo(0, 0);
                }
            });
        })();
    </script>
    @{
        var seo = await SeoService.ObterMetaAsync(ViewData["Seo"] as SeoMeta);
        var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
        // Canônico sem barra final (/cidade/ declara /cidade) — evita duplicatas.
        var caminhoCanonico = Context.Request.Path.Value is { Length: > 1 } p && p.EndsWith('/')
            ? p.TrimEnd('/')
            : Context.Request.Path.ToString();
        var canonical = baseUrl + Context.Request.PathBase + caminhoCanonico;
        var tituloPagina = !string.IsNullOrWhiteSpace(seo.Titulo) ? seo.Titulo : ViewData["Title"]?.ToString();
        var tituloFinal = string.IsNullOrWhiteSpace(tituloPagina) ? seo.NomeSite : $"{tituloPagina} — {seo.NomeSite}";
        // og:title/twitter:title curtos (sem o sufixo do site) — recomendado até ~70 caracteres.
        var tituloOg = string.IsNullOrWhiteSpace(tituloPagina) ? seo.NomeSite : tituloPagina;
        var descricao = Cortar(seo.Descricao ?? seo.SiteDescricao, 160);
        var imagem = string.IsNullOrWhiteSpace(seo.ImagemUrl) ? null
            : seo.ImagemUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? seo.ImagemUrl : baseUrl + seo.ImagemUrl;
    }
    <title>@tituloFinal</title>
    @if (!string.IsNullOrWhiteSpace(descricao))
    {
        <meta name="description" content="@descricao" />
    }
    @if (seo.NoIndex)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <link rel="canonical" href="@canonical" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="@seo.NomeSite" />
    <meta property="og:type" content="@seo.Tipo" />
    <meta property="og:title" content="@tituloOg" />
    @if (!string.IsNullOrWhiteSpace(descricao))
    {
        <meta property="og:description" content="@descricao" />
    }
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="pt_BR" />
    @if (imagem is not null)
    {
        <meta property="og:image" content="@imagem" />
    }
    @if (seo.Tipo == "article" && !string.IsNullOrWhiteSpace(seo.DataPublicacao))
    {
        <meta property="article:published_time" content="@seo.DataPublicacao" />
    }

    <!-- Twitter Cards -->
    @if (imagem is not null)
    {
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@tituloOg" />
        @if (!string.IsNullOrWhiteSpace(descricao))
        {
            <meta name="twitter:description" content="@descricao" />
        }
        <meta name="twitter:image" content="@imagem" />
    }
    else
    {
        <meta name="twitter:card" content="summary" />
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* Fontes: pedido por FAIXA de peso (variável) em vez de peso a peso — 4 famílias em
       5 arquivos em vez de 12, e cobrindo os pesos que o CSS realmente usa
       (Inter 500/600 e Fraunces 800, que antes o navegador aproximava). *@
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600..800&family=Caveat:wght@400..700&family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Inter:wght@300..700&display=swap" rel="stylesheet" />
    @* Ícones: sprite local (wwwroot/img/icones.svg, gerado por tools/gerar-sprite-icones.py)
       no lugar dos 414 KB da lib do jsdelivr. Mesma chamada lucide.createIcons(). *@
    <script src="~/js/lucide-local.js" asp-append-version="true" defer></script>
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    @await Component.InvokeAsync("ThemeSite")
</head>
<body data-app-base="@Url.Content("~/")">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    @RenderBody()

    <!-- VLibras: acessibilidade em Libras (padrão gov.br para órgãos públicos) -->
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper><div class="vw-plugin-top-wrapper"></div></div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>try { new window.VLibras.Widget('https://vlibras.gov.br/app'); } catch (e) {}</script>

    <!-- Overlay de busca pública (lupa das navbars) -->
    <div class="busca-overlay" id="buscaOverlay" role="dialog" aria-modal="true" aria-label="Buscar no portal" hidden>
        <button type="button" class="busca-overlay-fechar" id="buscaFechar" aria-label="Fechar busca">
            <i data-lucide="x" class="icon-lg"></i>
        </button>
        <div style="width:min(640px,100%);">
            <form method="get" action="@Url.Content("~/buscar")" class="busca-overlay-form" role="search">
                <i data-lucide="search" class="icon-lg" style="color:#9ca3af;flex:none;"></i>
                <input type="search" name="q" id="buscaOverlayInput" class="busca-overlay-input"
                       placeholder="Buscar maravilhas, notícias, eventos..." aria-label="Buscar no portal"
                       minlength="2" maxlength="100" autocomplete="off" />
                <button type="submit" class="btn-primary busca-form-btn">Buscar</button>
            </form>
            <p class="busca-overlay-dica">Digite e tecle Enter — Esc fecha.</p>
        </div>
    </div>

    <!-- Botão voltar ao topo (aparece após rolar a página) -->
    <button type="button" class="scroll-top" id="scrollTop" aria-label="Voltar ao topo" title="Voltar ao topo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
        <span class="scroll-top-ring" aria-hidden="true"></span>
    </button>

    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        // PWA: shell offline (só no portal público, nunca no Gerenciador).
        if ('serviceWorker' in navigator && !location.pathname.startsWith('/Gerenciador') && !location.pathname.startsWith('/Operador')) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function () {});
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    /// <summary>Corta o texto para meta description, sem quebrar no meio de uma palavra.</summary>
    private static string Cortar(string? texto, int max)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "";
        var t = texto.Trim();
        if (t.Length <= max) return t;
        var corte = t.LastIndexOf(' ', max);
        return (corte > max / 2 ? t[..corte] : t[..max]) + "…";
    }
}
