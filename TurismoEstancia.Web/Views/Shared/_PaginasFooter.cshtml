<footer class="paginas-footer">
    <div class="paginas-footer-inner">
        <div class="paginas-footer-brand">
            @await Component.InvokeAsync("LogoSite", new { altura = 30, chave = "logo" })
            <p>Portal de Turismo de Estância/SE — Capital Sergipana da Cultura.</p>
        </div>
        <div class="paginas-footer-contatos">
            <div class="paginas-footer-contatos-titulo"><i data-lucide="contact" class="icon-lg"></i> Contatos</div>
            @await Component.InvokeAsync("ContatosRodape")
        </div>
        <nav class="paginas-footer-links" aria-label="Navegação do rodapé">
            <a href="@Url.Content("~/cidade")">Nossa Cidade</a>
            <a href="@Url.Content("~/cultura")">Nossa Cultura</a>
            <a href="@Url.Content("~/grupos-populares")">Grupos Populares</a>
            <a href="@Url.Content("~/gastronomia")">Gastronomia</a>
            <a href="@Url.Content("~/lugares")">Lugares que Encantam</a>
            <a href="@Url.Content("~/")">← Voltar ao início</a>
        </nav>
    </div>
    <div class="paginas-footer-bottom">
        © @DateTime.Now.Year Prefeitura Municipal de Estância/SE — Todos os direitos reservados
    </div>
</footer>
