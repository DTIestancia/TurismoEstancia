<header class="paginas-nav">
    <div class="paginas-nav-inner">
        <a href="@Url.Content("~/")" class="paginas-brand">
            @await Component.InvokeAsync("LogoSite", new { altura = 34 })
        </a>
        <button class="paginas-nav-toggle" id="paginasNavToggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="paginasNavLinks">
            <span class="paginas-nav-toggle-icon" aria-hidden="true"></span>
        </button>
        <nav class="paginas-nav-links" id="paginasNavLinks" aria-label="Seções do portal">
            @foreach (var link in MenuPortal.Header)
            {
                <a href="@Url.Content(link.Url)">@link.Rotulo</a>
            }
            <a href="@Url.Content("~/")" class="paginas-nav-home paginas-nav-home-menu"><i data-lucide="arrow-left" class="icon-lg"></i> Início</a>
        </nav>
        <a href="@Url.Content("~/")" class="paginas-nav-home paginas-nav-home-top"><i data-lucide="arrow-left" class="icon-lg"></i> Início</a>
    </div>
</header>
