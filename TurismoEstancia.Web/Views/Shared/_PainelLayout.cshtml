@using TurismoEstancia.Authorization.Services
@using TurismoEstancia.IdentityClass.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager
@{
    var usuario = await UserManager.GetUserAsync(User);
    // Com múltiplas claims (Gerenciador + Operador), o maior privilégio vence.
    var gerenciador = User.FindAll(Perfis.TipoClaim).Any(c => c.Value == Perfis.Gerenciador);
    // Modo embutido (?embutido=1): o formulário de Criar abre dentro do modal
    // das telas de lista — esconde sidebar/topbar/subnav para o iframe mostrar
    // só o formulário, sem duplicar views.
    var embutido = ViewContext.HttpContext.Request.Query["embutido"].ToString() == "1";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>@ViewData["Title"] - Painel Turismo Estância</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;1,9..144,400;1,9..144,700&family=Inter:wght@300;400;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/lucide@1.27.0/dist/umd/lucide.min.js" defer></script>
    <link rel="stylesheet" href="~/css/painel.css" asp-append-version="true" />
    @await Component.InvokeAsync("ThemeSite")
</head>
<body class="painel-body">
    <div class="painel @(embutido ? "painel--embutido" : "")">
        <!-- ===== Sidebar ===== -->
        <aside class="painel-sidebar">
            <div class="painel-brand">
                <div class="painel-brand-logo">
                    @await Component.InvokeAsync("LogoSite", new { altura = 26 })
                </div>
                <div class="painel-brand-text">
                    Turismo Estância
                    <small>Painel de gestão</small>
                </div>
            </div>

            <nav class="painel-nav">
                <a class="painel-nav-link @(IsAreaPage("Gerenciador","Dashboard") || IsAreaPage("Operador","Dashboard") ? "active" : "")"
                   asp-area="@(gerenciador ? "Gerenciador" : "Operador")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i data-lucide="layout-dashboard"></i> Dashboard
                </a>
                <a class="painel-nav-link" asp-controller="Home" asp-action="Index" target="_blank">
                    <i data-lucide="globe"></i> Ver portal
                </a>

                @if (gerenciador)
                {
                    <div class="painel-nav-title">Conteúdo do site</div>
                    <a class="painel-nav-link @(IsAreaSecao("hero") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Hero">
                        <i data-lucide="images"></i> Hero
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("cidade") || IsAreaPage("Gerenciador","Estatisticas") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Cidade">
                        <i data-lucide="landmark"></i> Nossa Cidade
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("cultura") || IsAreaPage("Gerenciador","GruposCulturais") || IsAreaPage("Gerenciador","TagsCulturais") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Cultura">
                        <i data-lucide="music"></i> Cultura
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("gastronomia") || IsAreaPage("Gerenciador","PratosTuristicos") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Gastronomia">
                        <i data-lucide="utensils"></i> Gastronomia
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("maravilhas") || IsAreaPage("Gerenciador","Categorias") || IsAreaPage("Gerenciador","PontosTuristicos") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Maravilhas">
                        <i data-lucide="gem"></i> 7 Maravilhas
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("agenda") || IsAreaPage("Gerenciador","Eventos") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Agenda">
                        <i data-lucide="calendar"></i> Agenda
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("noticias") || IsAreaPage("Gerenciador","Noticias") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Noticias">
                        <i data-lucide="newspaper"></i> Notícias
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("roteiros") || IsAreaPage("Gerenciador","Roteiros") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Roteiros">
                        <i data-lucide="route"></i> Roteiros
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("mapa") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Mapa">
                        <i data-lucide="map"></i> Mapa
                    </a>
                    <a class="painel-nav-link @(IsAreaSecao("rodape") || IsAreaPage("Gerenciador","Contatos") ? "active" : "")" asp-area="Gerenciador" asp-controller="Secoes" asp-action="Rodape">
                        <i data-lucide="phone"></i> Rodapé
                    </a>
                    <a class="painel-nav-link @(IsAreaPage("Gerenciador","Galeria") ? "active" : "")" asp-area="Gerenciador" asp-controller="Galeria" asp-action="Index">
                        <i data-lucide="camera"></i> Galeria
                    </a>

                    <div class="painel-nav-title">Sistema</div>
                    <a class="painel-nav-link @(IsAreaPage("Gerenciador","Tema") ? "active" : "")" asp-area="Gerenciador" asp-controller="Tema" asp-action="Index">
                        <i data-lucide="palette"></i> Tema e cores
                    </a>
                    <a class="painel-nav-link @(IsAreaPage("Gerenciador","Configuracoes") ? "active" : "")" asp-area="Gerenciador" asp-controller="Configuracoes" asp-action="Index">
                        <i data-lucide="settings"></i> Configurações
                    </a>
                    <a class="painel-nav-link @(IsAreaPage("Gerenciador","Newsletter") ? "active" : "")" asp-area="Gerenciador" asp-controller="Newsletter" asp-action="Index">
                        <i data-lucide="mail"></i> Newsletter
                    </a>
                    <a class="painel-nav-link @(IsAreaPage("Gerenciador","Avaliacoes") ? "active" : "")" asp-area="Gerenciador" asp-controller="Avaliacoes" asp-action="Index">
                        <i data-lucide="star"></i> Avaliações
                        @if (ViewData["PendentesAvaliacoes"] is int pend && pend > 0)
                        {
                            <span class="painel-badge">@pend</span>
                        }
                    </a>
                }
                else
                {
                    <div class="painel-nav-title">Operação</div>
                    <a class="painel-nav-link @(IsAreaPage("Operador","Eventos") ? "active" : "")" asp-area="Operador" asp-controller="Eventos" asp-action="Index">
                        <i data-lucide="calendar"></i> Eventos
                    </a>
                    <a class="painel-nav-link @(IsAreaPage("Operador","Newsletter") ? "active" : "")" asp-area="Operador" asp-controller="Newsletter" asp-action="Index">
                        <i data-lucide="mail"></i> Newsletter
                    </a>
                }
            </nav>

            <div class="painel-sidebar-footer">
                <i data-lucide="shield"></i> v1.0 · Secretaria de Turismo
            </div>
        </aside>

        <!-- ===== Conteúdo ===== -->
        <div class="painel-main">
            <header class="painel-topbar">
                <div class="painel-topbar-title">@ViewData["Title"]</div>
                <div class="painel-topbar-user">
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="painel-actions">
                        <button type="submit" class="btn-painel btn-painel--ghost btn-painel--sm" title="Sair">
                            <i data-lucide="log-out"></i> Sair
                        </button>
                    </form>
                </div>
            </header>

            <main class="painel-content">
                @if (!embutido
                    && !string.IsNullOrWhiteSpace(ViewData["AreaAtiva"] as string)
                    && string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Gerenciador", StringComparison.OrdinalIgnoreCase))
                {
                    <partial name="_SubnavAreas" />
                }
                @if (!embutido)
                {
                    // Modal único de cadastro: os botões "Novo ..." das telas de
                    // lista abrem aqui o formulário de Criar (iframe ?embutido=1).
                    <dialog class="painel-criar-dialog" id="criarDialog" aria-label="Cadastrar novo item">
                        <div class="painel-criar-dialog-inner">
                            <div class="painel-criar-dialog-header">
                                <h3 class="painel-criar-dialog-title" id="criarDialogTitulo"><i data-lucide="plus-circle"></i> Cadastrar</h3>
                                <div class="painel-criar-dialog-acoes">
                                    <a class="btn-painel btn-painel--ghost btn-painel--sm" id="criarDialogAbrirAba" href="#" target="_blank" rel="noopener" title="Abrir em nova aba">
                                        <i data-lucide="external-link"></i> Nova aba
                                    </a>
                                    <button type="button" class="painel-criar-dialog-close" id="criarDialogFechar" title="Fechar">
                                        <i data-lucide="x"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="painel-criar-dialog-corpo">
                                <iframe id="criarDialogFrame" src="about:blank" title="Formulário de cadastro"></iframe>
                            </div>
                        </div>
                    </dialog>
                }
                @if (TempData["PainelOk"] is string ok)
                {
                    <div class="painel-alert painel-alert--ok"><i data-lucide="check-circle"></i> @ok</div>
                }
                @if (TempData["PainelErro"] is string erro)
                {
                    <div class="painel-alert painel-alert--erro"><i data-lucide="alert-circle"></i> @erro</div>
                }
                @RenderBody()
                @if (embutido && TempData["PainelOk"] is string)
                {
                    // Dentro do modal de cadastro, avisa a página (que abriu o
                    // dialog) que o item foi salvo — ela fecha e recarrega a lista.
                    <script>if (window.parent !== window) { window.parent.postMessage('painel-salvo', '*'); }</script>
                }
            </main>
        </div>
    </div>

    <script src="~/js/painel.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    // Compara área/controller atuais para destacar o link ativo.
    private bool IsAreaPage(string area, string controller)
    {
        var rotaArea = ViewContext.RouteData.Values["area"]?.ToString();
        var rotaController = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(rotaArea, area, StringComparison.OrdinalIgnoreCase)
            && string.Equals(rotaController, controller, StringComparison.OrdinalIgnoreCase);
    }

    // True quando estamos na página de uma área do portal (Secoes/<Area>).
    private bool IsAreaSecao(string area)
    {
        return IsAreaPage("Gerenciador", "Secoes")
            && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), area, StringComparison.OrdinalIgnoreCase);
    }
}
