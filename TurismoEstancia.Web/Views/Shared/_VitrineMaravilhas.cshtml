@model IReadOnlyList<PontoTuristicoDto>
@if (Model.Count == 0)
{
    <div class="vitrine-empty">Em breve, as maravilhas de Estância estarão aqui.</div>
}
else
{
    <div class="vitrine" id="wondersVitrine" data-total="@Model.Count">
        <div class="vitrine-blob" aria-hidden="true"></div>

        <!-- Baralho de cartas com prévia: a carta central é a maravilha exibida;
             a próxima espreita pela direita e a anterior fica à esquerda (já passou).
             No celular, arrastar passa as cartas; as setas ficam no centro da foto. -->
        <div class="vitrine-posicao">
            <div class="vitrine-deck" id="vitrineDeck" role="list" aria-label="As 7 maravilhas de Estância">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var ponto = Model[i];
                    var cor = ponto.CategoriaCor ?? "#F97E31";
                    <article class="vitrine-carta" role="listitem" data-index="@i" aria-label="Maravilha @((i + 1).ToString("00")): @ponto.Nome">
                        <figure class="vitrine-foto">
                            @if (ponto.CapaArquivoId is long capa)
                            {
                                <img src="@Url.Content($"~/arquivo/{capa}")" alt="@ponto.Nome" loading="lazy" />
                            }
                            else
                            {
                                <img src="" alt="@ponto.Nome" loading="lazy" />
                            }
                        </figure>
                        <div class="vitrine-info">
                            <span class="vitrine-cat" style="color:color-mix(in srgb, @cor 70%, #fff);border-color:@cor;background:@(cor + "26");">@ponto.CategoriaNome</span>
                            <h3 class="vitrine-titulo">@ponto.Nome</h3>
                            <div class="vitrine-card">
                                <p class="vitrine-desc">@ponto.Descricao</p>
                                <div class="vitrine-card-foot">
                                    @if (!string.IsNullOrWhiteSpace(ponto.Tag))
                                    {
                                        <span class="vitrine-tag">@ponto.Tag</span>
                                    }
                                    <a class="btn-primary vitrine-btn"
                                       href="@Url.Content($"~/lugares/{ponto.Id}/{Slug.De(ponto.Nome)}")"
                                       data-track="ver-maravilha" data-track-id="@ponto.Id" data-track-nome="@ponto.Nome">
                                        Ver detalhes <i data-lucide="arrow-right" class="icon-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <button type="button" class="vitrine-seta vitrine-seta--overlay vitrine-seta--prev" id="vitrinePrev" aria-label="Maravilha anterior">
                <i data-lucide="chevron-left" class="icon-lg"></i>
            </button>
            <button type="button" class="vitrine-seta vitrine-seta--overlay vitrine-seta--next" id="vitrineNext" aria-label="Próxima maravilha">
                <i data-lucide="chevron-right" class="icon-lg"></i>
            </button>
        </div>

        <p class="vitrine-hint" id="vitrineCounter">Arraste ou use as setas para conhecer as maravilhas</p>
    </div>
}
